{
  "Program": {
    "prefix": "program",
    "body": [
      "program ${1:name} \"${2:Title}\"",
      "use money",
      "object ${3:item} \"${4:Items}\" {",
      "  fields { note: text }",
      "  attach payment = money.transfer {",
      "    payer: actor, payee: owner, amount: ${5:10} SAR",
      "    expose pay as pay",
      "  }",
      "}"
    ]
  }
}
