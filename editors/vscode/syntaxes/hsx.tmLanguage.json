{
  "scopeName": "source.hsx",
  "name": "HSX 4",
  "patterns": [
    {
      "name": "comment.line.double-slash.hsx",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.hsx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\.",
          "name": "constant.character.escape.hsx"
        }
      ]
    },
    {
      "name": "constant.numeric.hsx",
      "match": "\\b\\d+(?:\\.\\d+)?(?:%|\\s+SAR|ms|[smhdw])?"
    },
    {
      "name": "keyword.control.hsx",
      "match": "\\b(program|header|use|object|attach|columns|subject|rename|party|role|currency|instrument|fields|lifecycle|action|expose|hide|as|cap|of|when|constraints|requires|invariants|moves|from|to|in|is|has|unique|on|count|sum|hours|between|and|timezone|evidence|family|check|result|maxAge|instruction|reserve|post|void|capture|boundary|key|fee|shares)\\b"
    },
    {
      "name": "storage.type.hsx",
      "match": "\\b(money|account|ref|date|duration|text|integer|percent|boolean|enum|list)\\b"
    }
  ]
}
