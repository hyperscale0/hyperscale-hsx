{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hyperscale0/hyperscale-hsx/spec/hsx-ir.schema.json",
  "title": "HSX compile artifacts",
  "description": "What `compile()` produces when the verdict is `valid` or `warning`, and what `hsx build` writes: the HSX-JSON IR document a runtime executes, plus the congruent Business Frame that describes the same product in business terms. This schema covers what the compiler EMITS. A runtime may accept a wider grammar; nothing the compiler emits may fall outside this file.",
  "type": "object",
  "required": ["document", "frame"],
  "additionalProperties": false,
  "properties": {
    "document": { "$ref": "#/$defs/document" },
    "frame": { "$ref": "#/$defs/frame" }
  },

  "$defs": {
    "snakeName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "camelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "nounRefPath": {
      "type": "string",
      "pattern": "^(fields|refs)\\.[a-z][A-Za-z0-9]*$|^nounInstanceId$"
    },
    "instanceValuePath": {
      "type": "string",
      "pattern": "^(fields|refs)\\.[a-z][A-Za-z0-9]*$"
    },
    "endpoint": {
      "description": "A party name, or one of the two endpoints every settlement has without declaring them: `platform` and `escrow`.",
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "isoDuration": {
      "description": "A fixed ISO-8601 duration. Calendar months never appear: they drift, so they cannot anchor an exact money deadline.",
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^P([0-9]+[WDHMS]|T[0-9]+[HMS])"
    },
    "prose": { "type": "string", "minLength": 1, "maxLength": 400 },

    "document": {
      "title": "HSX-JSON IR document",
      "description": "One compiled program. Every settlement in the source becomes one noun; every noun carries its money fields, its conservation partitions, and one verb per admissible lifecycle step.",
      "type": "object",
      "required": ["hsx", "nouns", "product", "title"],
      "additionalProperties": false,
      "properties": {
        "hsx": {
          "description": "The IR format version. A consumer reads this integer to decide whether it understands the document.",
          "const": 1
        },
        "product": {
          "description": "The program name from the `program` header.",
          "$ref": "#/$defs/snakeName"
        },
        "title": {
          "description": "The program's human title, from the header string or derived from its name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "subjects": {
          "description": "One entry per declared asset: the non-money thing the settlements are about.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["kind", "title", "value"],
            "additionalProperties": false,
            "properties": {
              "kind": { "$ref": "#/$defs/snakeName" },
              "title": { "type": "string", "minLength": 1, "maxLength": 60 },
              "value": { "enum": ["none", "optional", "required"] }
            }
          }
        },
        "nouns": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/noun" }
        }
      }
    },

    "noun": {
      "description": "One lowered settlement.",
      "type": "object",
      "required": ["id", "summary", "title", "verbs"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The settlement's own name. Settlement names are noun ids; nothing renames them.",
          "$ref": "#/$defs/snakeName"
        },
        "prefix": {
          "description": "Optional explicit letter-only instance id prefix for generated child nouns.",
          "type": "string",
          "pattern": "^[a-z]{2,8}$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
        "desc": { "type": "string", "minLength": 1, "maxLength": 400 },
        "escrow": {
          "description": "Present and true when this settlement takes custody of money in its own escrow account.",
          "const": true
        },
        "distinctParties": {
          "description": "Present and true when two of this settlement's roles must be different parties at runtime.",
          "const": true
        },
        "actors": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/snakeName" },
          "additionalProperties": { "enum": ["payer", "beneficiary", "party"] }
        },
        "aggregateInvariants": {
          "description": "Per-parent caps over generated child nouns, enforced under the parent lock before a child enters a counted status.",
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "childField",
                  "childNounId",
                  "childRefField",
                  "childStatuses",
                  "parentField"
                ],
                "additionalProperties": false,
                "properties": {
                  "childField": { "$ref": "#/$defs/camelName" },
                  "childNounId": { "$ref": "#/$defs/snakeName" },
                  "childRefField": { "$ref": "#/$defs/camelName" },
                  "childStatuses": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": { "$ref": "#/$defs/snakeName" }
                  },
                  "parentField": { "$ref": "#/$defs/camelName" }
                }
              },
              {
                "type": "object",
                "required": [
                  "count",
                  "childNounId",
                  "childRefField",
                  "childStatuses",
                  "parentField"
                ],
                "additionalProperties": false,
                "properties": {
                  "count": { "const": true },
                  "childNounId": { "$ref": "#/$defs/snakeName" },
                  "childRefField": { "$ref": "#/$defs/camelName" },
                  "childStatuses": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": { "$ref": "#/$defs/snakeName" }
                  },
                  "parentField": { "$ref": "#/$defs/camelName" }
                }
              }
            ]
          }
        },
        "derivedAmounts": {
          "description": "Machine-computed amounts derived from stored money fields. Callers never supply target fields.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["field", "rounding", "rule", "sourceField"],
            "additionalProperties": false,
            "properties": {
              "field": { "$ref": "#/$defs/camelName" },
              "rounding": { "const": "floor" },
              "rule": {
                "type": "object",
                "required": ["bps", "kind"],
                "additionalProperties": false,
                "properties": {
                  "bps": { "type": "integer", "minimum": 1, "maximum": 9999 },
                  "kind": { "const": "percentage_of" }
                }
              },
              "sourceField": { "$ref": "#/$defs/camelName" }
            }
          }
        },
        "fields": {
          "description": "Every value an instance stores. `money` is a positive minor-unit integer; `date` is required, `date?` optional; `beneficiary` is a payout beneficiary ID; `ref:<noun>` is a required noun-instance reference.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/camelName" },
          "additionalProperties": {
            "type": "object",
            "required": ["desc", "type"],
            "additionalProperties": false,
            "properties": {
              "desc": { "type": "string", "minLength": 1, "maxLength": 200 },
              "type": {
                "oneOf": [
                  {
                    "enum": [
                      "money",
                      "date",
                      "date?",
                      "text",
                      "text?",
                      "currency",
                      "beneficiary",
                      "count"
                    ]
                  },
                  { "type": "string", "pattern": "^const:[1-9][0-9]*$" },
                  { "type": "string", "pattern": "^ref:[a-z][a-z0-9_]*$" }
                ]
              }
            }
          }
        },
        "partitions": {
          "description": "Conservation laws over stored amounts: the piece fields sum exactly to the total field, proven at create admission before any money moves.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["pieces", "total"],
            "additionalProperties": false,
            "properties": {
              "pieces": {
                "type": "array",
                "minItems": 2,
                "maxItems": 12,
                "items": { "$ref": "#/$defs/camelName" }
              },
              "total": { "$ref": "#/$defs/camelName" }
            }
          }
        },
        "verbs": {
          "description": "One entry per admissible lifecycle step. `create` is always present and is the only verb with no `from`.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/snakeName" },
          "additionalProperties": { "$ref": "#/$defs/verb" }
        }
      }
    },

    "verb": {
      "type": "object",
      "required": ["summary", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "States this verb may run in. Absent on `create`.",
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/snakeName" }
        },
        "to": {
          "description": "The state the instance is in once this verb succeeds.",
          "$ref": "#/$defs/snakeName"
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
        "publicIntent": {
          "description": "The stable action-first lowerCamelCase operation name exposed to callers. System due verbs omit it.",
          "$ref": "#/$defs/camelName"
        },
        "moneyEvent": {
          "description": "The Business Frame money event this verb's moves belong to.",
          "$ref": "#/$defs/snakeName"
        },
        "moves": {
          "description": "The ledger operations this verb performs, in order, as one atomic batch.",
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/move" }
        },
        "requires": {
          "description": "Referenced noun instances whose status and stored values gate this verb before any movement runs.",
          "type": "object",
          "maxProperties": 8,
          "propertyNames": { "$ref": "#/$defs/camelName" },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": { "$ref": "#/$defs/snakeName" }
              },
              {
                "type": "object",
                "required": ["statuses"],
                "additionalProperties": false,
                "anyOf": [
                  { "required": ["bind"] },
                  { "required": ["match"] },
                  { "required": ["unique"] }
                ],
                "properties": {
                  "bind": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 8,
                    "propertyNames": { "$ref": "#/$defs/camelName" },
                    "additionalProperties": { "$ref": "#/$defs/nounRefPath" }
                  },
                  "match": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 8,
                    "propertyNames": { "$ref": "#/$defs/nounRefPath" },
                    "additionalProperties": { "$ref": "#/$defs/nounRefPath" }
                  },
                  "statuses": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": { "$ref": "#/$defs/snakeName" }
                  },
                  "unique": { "const": true }
                }
              }
            ]
          }
        },
        "due": {
          "description": "The verb runs when the stored date in `field` (plus `offset`) arrives, under the named rule.",
          "type": "object",
          "required": ["field"],
          "additionalProperties": false,
          "properties": {
            "field": { "$ref": "#/$defs/camelName" },
            "rule": { "$ref": "#/$defs/snakeName" },
            "offset": { "$ref": "#/$defs/isoDuration" }
          }
        },
        "deadline": {
          "description": "The verb stops being admissible once the stored date in `field` (plus `offset`) has passed.",
          "type": "object",
          "required": ["field"],
          "additionalProperties": false,
          "properties": {
            "field": { "$ref": "#/$defs/camelName" },
            "offset": { "$ref": "#/$defs/isoDuration" }
          }
        },
        "setsAt": {
          "description": "Running this verb stamps `field` with now plus `offset`. A marker records occurrence and cannot drive a due condition or deadline.",
          "type": "object",
          "required": ["field", "offset"],
          "additionalProperties": false,
          "properties": {
            "field": { "$ref": "#/$defs/camelName" },
            "marker": { "const": true },
            "offset": { "$ref": "#/$defs/isoDuration" }
          }
        },
        "port": {
          "description": "The verb is a decision port: only these actors may call it, and the answer comes from the tenant's own backend.",
          "type": "object",
          "required": ["allowed"],
          "additionalProperties": false,
          "properties": {
            "allowed": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/snakeName" }
            },
            "fields": {
              "type": "object",
              "maxProperties": 4,
              "propertyNames": { "$ref": "#/$defs/camelName" },
              "additionalProperties": { "enum": ["text"] }
            }
          }
        },
        "captureInput": {
          "description": "Persist selected caller input fields under noun refs so the terminal receipt retains decision evidence.",
          "type": "object",
          "maxProperties": 4,
          "propertyNames": { "$ref": "#/$defs/camelName" },
          "additionalProperties": { "$ref": "#/$defs/camelName" }
        },
        "payout": {
          "description": "Create one external payout instruction from stored noun values and capture its durable reference.",
          "type": "object",
          "required": [
            "amount",
            "beneficiaryField",
            "beneficiaryPartyField",
            "capture",
            "currencyField",
            "sourceAccountField",
            "speed"
          ],
          "additionalProperties": false,
          "properties": {
            "amount": { "$ref": "#/$defs/instanceValuePath" },
            "beneficiaryField": { "$ref": "#/$defs/camelName" },
            "beneficiaryPartyField": { "$ref": "#/$defs/camelName" },
            "capture": { "$ref": "#/$defs/camelName" },
            "currencyField": { "$ref": "#/$defs/camelName" },
            "sourceAccountField": { "$ref": "#/$defs/camelName" },
            "speed": { "const": "standard" }
          }
        },
        "requiresSettlement": {
          "description": "Allow a system transition only after durable settlement evidence matches the captured payout.",
          "type": "object",
          "required": ["capture", "payoutRef"],
          "additionalProperties": false,
          "properties": {
            "capture": { "$ref": "#/$defs/camelName" },
            "payoutRef": { "$ref": "#/$defs/camelName" }
          }
        },
        "signedSum": {
          "description": "A machine-computed signed sum over frozen child rows. The caller cannot supply the result.",
          "type": "object",
          "required": ["amountRef", "onNegative", "onZero", "sources"],
          "additionalProperties": false,
          "properties": {
            "amountRef": { "$ref": "#/$defs/camelName" },
            "onNegative": { "const": "refuse" },
            "onZero": { "enum": ["refuse", "skip_steps"] },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": [
                  "amountField",
                  "nounId",
                  "refField",
                  "sign",
                  "statuses",
                  "subtotalRef"
                ],
                "additionalProperties": false,
                "properties": {
                  "amountField": { "$ref": "#/$defs/camelName" },
                  "nounId": { "$ref": "#/$defs/snakeName" },
                  "refField": { "$ref": "#/$defs/camelName" },
                  "sign": { "enum": ["add", "subtract"] },
                  "statuses": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": { "$ref": "#/$defs/snakeName" }
                  },
                  "subtotalRef": { "$ref": "#/$defs/camelName" }
                }
              }
            }
          }
        },
        "distribute": {
          "description": "A machine-computed deterministic largest-remainder share of a frozen parent pool.",
          "type": "object",
          "required": [
            "amountRef",
            "onZero",
            "pool",
            "refField",
            "statuses",
            "weightField"
          ],
          "additionalProperties": false,
          "properties": {
            "amountRef": { "$ref": "#/$defs/camelName" },
            "onZero": { "enum": ["refuse", "skip_steps"] },
            "pool": {
              "type": "object",
              "required": ["from", "path"],
              "additionalProperties": false,
              "properties": {
                "from": { "const": "parent" },
                "path": { "$ref": "#/$defs/nounRefPath" }
              }
            },
            "refField": { "$ref": "#/$defs/camelName" },
            "statuses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": { "$ref": "#/$defs/snakeName" }
            },
            "weightField": { "$ref": "#/$defs/camelName" }
          }
        },
        "requiresAggregate": {
          "description": "Locked aggregate conditions over child or sibling rows that must hold before the verb runs.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["check", "over", "refField", "statuses"],
            "additionalProperties": false,
            "properties": {
              "check": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["amountField", "kind", "targetField"],
                    "additionalProperties": false,
                    "properties": {
                      "amountField": { "$ref": "#/$defs/camelName" },
                      "kind": {
                        "enum": ["sum_at_least", "sum_below", "sum_exactly"]
                      },
                      "targetField": { "$ref": "#/$defs/camelName" }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["kind"],
                    "additionalProperties": false,
                    "properties": { "kind": { "const": "all_in" } }
                  },
                  {
                    "type": "object",
                    "required": ["kind", "targetField"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": { "const": "count_at_least" },
                      "targetField": { "$ref": "#/$defs/camelName" }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["field", "kind"],
                    "additionalProperties": false,
                    "properties": {
                      "field": { "$ref": "#/$defs/camelName" },
                      "kind": { "const": "count_equals_field" }
                    }
                  }
                ]
              },
              "nounId": { "$ref": "#/$defs/snakeName" },
              "over": { "enum": ["children", "siblings"] },
              "refField": { "$ref": "#/$defs/camelName" },
              "statuses": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": { "$ref": "#/$defs/snakeName" }
              }
            }
          }
        },
        "requiresExposure": {
          "description": "Atomic exposure caps over rows sharing one anchor. The current row contributes to the checked sum.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "amountField",
              "anchorField",
              "capField",
              "childNounId",
              "statuses"
            ],
            "additionalProperties": false,
            "properties": {
              "amountField": { "$ref": "#/$defs/camelName" },
              "anchorField": { "$ref": "#/$defs/camelName" },
              "capField": { "$ref": "#/$defs/camelName" },
              "capOnAnchor": { "const": true },
              "childNounId": { "$ref": "#/$defs/snakeName" },
              "statuses": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": { "$ref": "#/$defs/snakeName" }
              }
            }
          }
        },
        "requiresDrainedAccount": {
          "description": "The verb is admissible only when the settlement's escrow account holds nothing, so a terminal state can never strand custody.",
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": { "const": "refs.escrowAccountId" }
          }
        }
      }
    },

    "move": {
      "description": "One ledger operation. `create` transfers money; `reserve` places a hold; `post` captures a reservation; `void` releases one.",
      "oneOf": [
        {
          "type": "object",
          "required": ["amount", "from", "key", "operation", "to"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "create" },
            "key": { "$ref": "#/$defs/snakeName" },
            "amount": {
              "oneOf": [
                { "$ref": "#/$defs/camelName" },
                { "type": "string", "pattern": "^refs\\.[a-z][A-Za-z0-9]*$" }
              ]
            },
            "from": { "$ref": "#/$defs/endpoint" },
            "to": { "$ref": "#/$defs/endpoint" },
            "moneyEvent": { "$ref": "#/$defs/snakeName" },
            "clawbackOf": {
              "description": "This transfer reverses the named earlier reservation.",
              "$ref": "#/$defs/snakeName"
            }
          }
        },
        {
          "type": "object",
          "required": ["amount", "from", "key", "operation", "to"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "reserve" },
            "key": { "$ref": "#/$defs/snakeName" },
            "amount": { "$ref": "#/$defs/camelName" },
            "expiresAt": { "$ref": "#/$defs/camelName" },
            "from": { "$ref": "#/$defs/endpoint" },
            "to": { "$ref": "#/$defs/endpoint" },
            "moneyEvent": { "$ref": "#/$defs/snakeName" }
          }
        },
        {
          "type": "object",
          "required": ["key", "operation", "reservation"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "post" },
            "key": { "$ref": "#/$defs/snakeName" },
            "reservation": { "$ref": "#/$defs/snakeName" },
            "amount": { "$ref": "#/$defs/camelName" },
            "partialOnly": { "const": true },
            "capture": {
              "type": "object",
              "maxProperties": 4,
              "propertyNames": { "$ref": "#/$defs/camelName" },
              "additionalProperties": { "const": "postedAmount" }
            }
          }
        },
        {
          "type": "object",
          "required": ["key", "operation", "reservation"],
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "void" },
            "key": { "$ref": "#/$defs/snakeName" },
            "reservation": { "$ref": "#/$defs/snakeName" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        }
      ]
    },

    "frame": {
      "title": "Business Frame",
      "description": "The same product stated in business terms, congruent with the document by construction: every money movement in the IR is covered by exactly one money event here.",
      "type": "object",
      "required": [
        "actors",
        "confidence",
        "conservationGroups",
        "design",
        "feePolicy",
        "fees",
        "headline",
        "mechanics",
        "moneyEvents",
        "offPlatform",
        "openQuestions",
        "rules",
        "subjects",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "headline": { "$ref": "#/$defs/prose" },
        "summary": { "$ref": "#/$defs/prose" },
        "confidence": {
          "description": "Always `high`: a compiled frame is derived, not inferred.",
          "const": "high"
        },
        "mechanics": {
          "description": "The commercial shapes this program's archetypes add up to.",
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "credit",
              "escrow",
              "insurance",
              "marketplace",
              "recurring_billing"
            ]
          }
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "maxCount", "minCount", "role"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "#/$defs/snakeName" },
              "label": { "$ref": "#/$defs/prose" },
              "minCount": { "type": "integer", "minimum": 0 },
              "maxCount": { "type": "integer", "minimum": 1 },
              "role": {
                "enum": [
                  "payer",
                  "beneficiary",
                  "provider",
                  "holder",
                  "platform"
                ]
              }
            }
          }
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "title"],
            "additionalProperties": false,
            "properties": {
              "kind": { "$ref": "#/$defs/snakeName" },
              "title": { "$ref": "#/$defs/prose" }
            }
          }
        },
        "moneyEvents": {
          "type": "array",
          "maxItems": 14,
          "items": { "$ref": "#/$defs/moneyEvent" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "fees": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "on", "structure"],
            "additionalProperties": false,
            "properties": {
              "label": { "$ref": "#/$defs/prose" },
              "on": { "$ref": "#/$defs/prose" },
              "structure": { "$ref": "#/$defs/prose" }
            }
          }
        },
        "feePolicy": { "enum": ["defined", "none"] },
        "design": {
          "description": "One line per lowered settlement, saying what the compiler decided and why.",
          "type": "array",
          "items": { "$ref": "#/$defs/prose" }
        },
        "offPlatform": {
          "description": "What changes hands outside the platform. Money never appears here.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "why"],
            "additionalProperties": false,
            "properties": {
              "label": { "$ref": "#/$defs/prose" },
              "why": { "$ref": "#/$defs/prose" }
            }
          }
        },
        "conservationGroups": {
          "description": "Always empty from the compiler: conservation is proven on the noun's `partitions`, not restated here.",
          "type": "array",
          "maxItems": 0
        },
        "openQuestions": {
          "description": "Always empty from the compiler: a program that left a question open would not have compiled.",
          "type": "array",
          "maxItems": 0
        }
      }
    },

    "moneyEvent": {
      "description": "One movement of money, named so a rule can gate it and a person can read it.",
      "type": "object",
      "required": [
        "allocationTotalBps",
        "amount",
        "amountDependencies",
        "amountMode",
        "amountSchedule",
        "distribution",
        "fromActor",
        "key",
        "kind",
        "label",
        "occurrence",
        "timing",
        "toActor",
        "trigger"
      ],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/snakeName" },
        "kind": {
          "enum": [
            "charge",
            "hold",
            "installment",
            "payout",
            "penalty",
            "premium",
            "refund"
          ]
        },
        "label": { "$ref": "#/$defs/prose" },
        "trigger": { "$ref": "#/$defs/prose" },
        "amount": {
          "description": "The amount in words. The exact arithmetic lives on the noun's fields and partitions.",
          "$ref": "#/$defs/prose"
        },
        "fromActor": { "$ref": "#/$defs/endpoint" },
        "toActor": { "$ref": "#/$defs/endpoint" },
        "occurrence": { "enum": ["once", "repeatable"] },
        "timing": { "enum": ["external_schedule", "on_lifecycle"] },
        "amountMode": {
          "enum": ["fixed", "runtime_bounded", "remaining_balance"]
        },
        "distribution": { "const": "single" },
        "allocationTotalBps": { "const": 0 },
        "amountDependencies": {
          "type": "array",
          "maxItems": 11,
          "items": { "$ref": "#/$defs/snakeName" }
        },
        "amountSchedule": { "type": "array", "maxItems": 0 }
      }
    },

    "rule": {
      "description": "A condition on the product: what must be true before a money event may run.",
      "type": "object",
      "required": [
        "allowedActors",
        "detail",
        "dueDriven",
        "enforcement",
        "gatesEvent",
        "key",
        "kind",
        "label",
        "tenantTunable"
      ],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/snakeName" },
        "kind": { "enum": ["deadline", "release_condition"] },
        "label": { "$ref": "#/$defs/prose" },
        "detail": { "$ref": "#/$defs/prose" },
        "allowedActors": {
          "type": "array",
          "items": { "$ref": "#/$defs/snakeName" }
        },
        "gatesEvent": {
          "description": "The money event this rule gates, or null when it gates the lifecycle rather than one movement.",
          "anyOf": [{ "$ref": "#/$defs/snakeName" }, { "type": "null" }]
        },
        "dueDriven": {
          "description": "True when a stored date decides the rule, false when a decision port does.",
          "type": "boolean"
        },
        "enforcement": {
          "description": "`tenant_app` means the tenant's own backend answers; `platform` means the runtime decides without asking.",
          "enum": ["platform", "tenant_app"]
        },
        "tenantTunable": {
          "description": "Always false from the compiler: the source is the only place these terms change.",
          "const": false
        }
      }
    }
  }
}
