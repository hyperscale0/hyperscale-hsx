{
  "name": "@hyperscale0/hsx",
  "version": "1.0.0-rc.1",
  "description": "The strictly typed HSX language: compile total financial programs into canonical UDL.",
  "keywords": [
    "hsx",
    "compiler",
    "dsl",
    "fintech",
    "escrow",
    "settlement",
    "payments",
    "money-movement",
    "language"
  ],
  "homepage": "https://github.com/hyperscale0/hyperscale-hsx#readme",
  "bugs": {
    "url": "https://github.com/hyperscale0/hyperscale-hsx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperscale0/hyperscale-hsx.git"
  },
  "license": "AGPL-3.0-only",
  "author": "Hyperscale LLC",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "hsx": "./dist/bin/hsx.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cost": "./src/cost.ts",
    "./package.json": "./package.json",
    "./std/*": "./std/*"
  },
  "files": [
    "AUTHORS",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSING.md",
    "README.md",
    "SECURITY.md",
    "TRADEMARKS.md",
    "bin",
    "dist",
    "docs",
    "examples",
    "skills",
    "std",
    "src"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "bun test && bun run docs:check && tsc -p tsconfig.json && bun run build && bun scripts/check-bin.ts",
    "docs:build": "bun scripts/docs/build.ts",
    "docs:check": "bun scripts/docs/check.ts",
    "examples:build": "bun scripts/examples/build.ts",
    "postpack": "bun scripts/pack-exports.ts restore",
    "prepack": "bun run build && bun scripts/pack-exports.ts apply",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hyperscale0/udl": "1.0.0-rc.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "6.0.3"
  },
  "contributors": [
    "Meshael AlBakaawi",
    "Amir Ayub",
    "Sara AlBakaawi"
  ]
}
