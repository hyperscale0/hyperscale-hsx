{
  "name": "@hyperscale0/hsx",
  "version": "4.1.0",
  "description": "The strictly typed HSX language: compile total financial programs into canonical UDL.",
  "keywords": [
    "hsx",
    "compiler",
    "dsl",
    "fintech",
    "escrow",
    "settlement",
    "payments",
    "money-movement",
    "language"
  ],
  "homepage": "https://github.com/hyperscale0/hyperscale-hsx#readme",
  "bugs": {
    "url": "https://github.com/hyperscale0/hyperscale-hsx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperscale0/hyperscale-hsx.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Hyperscale LLC",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "hsx": "./dist/bin/hsx.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cost": "./src/cost.ts",
    "./package.json": "./package.json",
    "./std/*": "./std/*"
  },
  "files": [
    "LICENSE.md",
    "NOTICE.md",
    "AUTHORS",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "bin",
    "dist",
    "docs",
    "examples",
    "std",
    "src"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run generate && tsc -p tsconfig.build.json && tsc -p playground/tsconfig.json && bun scripts/build-playground.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test test",
    "docs:build": "bun scripts/docs.ts",
    "postpack": "bun scripts/pack-exports.ts restore",
    "prepack": "bun run build && bun scripts/pack-exports.ts apply",
    "std:bundle": "bun scripts/bundle-std.ts",
    "generate": "bun run std:bundle && bun run docs:build",
    "prepare": "bun run std:bundle",
    "check": "bun run typecheck && tsc -p playground/tsconfig.json && bun test test"
  },
  "dependencies": {
    "@hyperscale0/adl": "1.0.0-beta.8",
    "@hyperscale0/udl": "4.1.0",
    "fast-sha256": "1.3.0"
  },
  "devDependencies": {
    "bun-types": "1.4.2",
    "typescript": "7.0.2"
  },
  "contributors": [
    "Meshael AlBakaawi",
    "Amir Ayub",
    "Sara AlBakaawi"
  ]
}
