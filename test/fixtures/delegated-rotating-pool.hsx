program community_circle "Community circle"
import { rotating_pool } from "std/settlements"

instrument community_membership {
  fields {
    communityCircleId { type: ref<community_circle>; pattern: "^circle_(sandbox|live)_[a-z0-9]{8,64}$"; }
    contributionDueAt { type: date; }
    memberAccountId { type: account<SAR>; pattern: "^acct_(sandbox|live)_[a-z0-9]{8,64}$"; "x-hyperscale-reference-filter": { column: role; values: [customer_balance]; }; }
    monthlyAmount { type: money<SAR>; }
    payoutDueAt { type: date; }
    potAccountId { type: account<SAR>; pattern: "^acct_(sandbox|live)_[a-z0-9]{8,64}$"; "x-hyperscale-reference-filter": { column: role; values: [customer_balance]; }; }
    turnRecipientAccountId { type: account<SAR>; pattern: "^acct_(sandbox|live)_[a-z0-9]{8,64}$"; "x-hyperscale-reference-filter": { column: role; values: [customer_balance]; }; }
  }
  lifecycle {
    states enrolled contributing funded paid;
    initial enrolled;
    on activate: enrolled -> contributing;
    on contribute: contributing -> funded;
    on payout: funded -> paid;
  }
  parties { beneficiary: turnRecipientAccountId; payer: memberAccountId; }
  agent_description: "Reach for community membership to take one seat in a community circle that is still forming. Joining is the only caller action here. The monthly contribution and the payout at this seat's turn both fire from the schedule under the machine principal. Circle-wide setup lives on community circle.";
  required: [communityCircleId, contributionDueAt, currency, memberAccountId, monthlyAmount, payoutDueAt, potAccountId, turnRecipientAccountId];
  action create {
    agent_description: "Take a seat in a circle that is still forming. The circle must be forming and it supplies the currency, the monthly amount, and the pot account. No money moves at join.";
    requires refs { field: communityCircleId; statuses: [forming]; bind: { currency: "fields.currency"; monthlyAmount: "fields.monthlyAmount"; potAccountId: "refs.potAccountId"; }; }
    moves: [];
    steps: [];
  }
  action activate {
    agent_description: "Follow the parent circle into the contributing state once the roster is full and the circle has activated. Refused while the circle is still forming. No money moves.";
    requires refs { field: communityCircleId; statuses: [active]; }
    moves: [];
    steps: [];
  }
  action contribute {
    due { field: contributionDueAt; }
    requires refs { field: communityCircleId; statuses: [active]; }
    moves: [{ key: contribution; operation: internal_transfer.create; bind: { amount: { from: instance; path: fields.monthlyAmount; }; currency: { from: instance; path: fields.currency; }; destinationAccountId: { from: instance; path: fields.potAccountId; }; "metadata.instrumentId": { from: const; value: community_membership; }; "metadata.instrumentInstanceId": { from: instance; path: instrumentInstanceId; }; "metadata.phase": { from: const; value: contribute; }; productId: { from: instance; path: productId; }; sourceAccountId: { from: instance; path: fields.memberAccountId; }; }; capture: { contributeContributionTransferId: transferId; }; }];
    steps: [];
  }
  action payout {
    due { field: payoutDueAt; }
    requires refs { field: communityCircleId; statuses: [active]; }
    moves: [{ key: payout; operation: internal_transfer.create; bind: { amount: { from: instance; path: fields.monthlyAmount; }; currency: { from: instance; path: fields.currency; }; destinationAccountId: { from: instance; path: fields.turnRecipientAccountId; }; "metadata.instrumentId": { from: const; value: community_membership; }; "metadata.instrumentInstanceId": { from: instance; path: instrumentInstanceId; }; "metadata.phase": { from: const; value: payout; }; productId: { from: instance; path: productId; }; sourceAccountId: { from: instance; path: fields.potAccountId; }; }; capture: { payoutPayoutTransferId: transferId; }; }];
    steps: [];
  }
}

instrument community_circle = rotating_pool<SAR>(
  contribution: monthlyAmount: money(SAR),
  count: seatCount: integer,
  first_due: startsAt,
  memo: note,
  membership: {
    instrument: community_membership;
    ref_field: communityCircleId;
    joined_status: enrolled;
    active_status: contributing;
    paid_status: paid;
    custody_ref: potAccountId;
    id_prefix: circle;
    active_parked: "members contribute and receive the pot through their published membership rows";
    min_members: 2;
    max_members: 24;
    contribution_description: "The contribution each member pays per cycle";
    currency_description: "ISO 4217 currency code";
    create_examples: [{ input: { monthlyAmount: "5000"; currency: SAR; seatCount: 4; productId: prd_sandbox_community1; startsAt: "2026-10-01T00:00:00.000Z"; tenantId: ten_sandbox_community1; }; name: create_community_circle; }];
    activate_examples: [{ input: { communityCircleId: circle_sandbox_community1; tenantId: ten_sandbox_community1; }; name: activate_community_circle; }];
    disband_examples: [{ input: { communityCircleId: circle_sandbox_community1; tenantId: ten_sandbox_community1; }; name: disband_community_circle; }];
    close_examples: [{ input: { communityCircleId: circle_sandbox_community1; tenantId: ten_sandbox_community1; }; name: close_community_circle; }];
  },
) {
  title: "Community circle";
  summary: "A rotating pool with published membership rows";
  description: "Each membership owns its contribution and payout schedule.";
  action create { summary: "Create the circle"; }
  action activate { summary: "Activate the full circle"; }
  action disband { summary: "Disband an unfilled circle"; }
  action close { summary: "Close the paid circle"; }
}
