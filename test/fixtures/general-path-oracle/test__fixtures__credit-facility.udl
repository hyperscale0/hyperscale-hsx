        "facilityLimit": {
          "description": "Facility limit in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "lenderAccountId": {
          "description": "The lender account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        }
      },
      "id": "facility",
      "idPrefix": "faci",
      "lifecycle": {
        "initial": "active",
        "states": [
          "active",
          "frozen",
          "closed"
