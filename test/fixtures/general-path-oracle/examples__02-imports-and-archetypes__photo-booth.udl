              },
              "key": "transfer",
              "operation": "internal_transfer.create"
            }
          ],
          "publicAction": "unfundPiece1Booking",
          "steps": [],
          "summary": "Return piece 1 to the renter on abandonment"
        },
        "unfund_piece_2": {
          "agentDescription": "Return piece 2 from escrow to the renter while abandoning a part-funded booking. Funding must have stopped at piece 2, or piece 3 must already be back. Piece 1 still has to be returned after this.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
