          "summary": "Return piece 3 to the renter on abandonment"
        }
      },
      "agentDescription": "Reach for booking when the renter must commit money up front and nobody is paid until confirm_delivery fires. Funding moves bookingFee into this settlement's own escrow account, where it stays until a release or an unwind pays it out. A straight-through payment with no custody step is a different shape.",
      "description": "Held payment: the renter funds bookingFee into this settlement's own escrow; company confirms through confirm_delivery to release",
      "feeRules": [
        {
          "amountField": "serviceFeeAmount",
          "baseField": "bookingFee",
          "bearerField": "renterAccountId",
          "position": "on_top",
          "rule": {
            "bps": 100,
            "kind": "bps"
          }
        },
        {
          "amountField": "piece3Amount",
          "baseField": "bookingFee",
          "bearerField": "companyAccountId",
          "position": "carved",
          "rule": {
            "bps": 300,
            "kind": "bps"
          }
        }
      ],
      "fields": {
        "bookingFee": {
          "description": "The gross held amount in SAR minor units; the piece fields below partition it exactly",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "companyAccountId": {
          "description": "The company account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "piece1Amount": {
          "description": "90% of bookingFee (carries the integer-division remainder): released to the company; on cancellation to the renter. Computed as floor(bookingFee * 9000 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "piece2Amount": {
          "description": "7% of bookingFee: released to the company; on cancellation to the company. Computed as floor(bookingFee * 700 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "piece3Amount": {
          "description": "3% of bookingFee: released to the platform; on cancellation to the company. Computed as floor(bookingFee * 300 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "platformAccountId": {
          "description": "The product fee collection account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-fee-collection-port": true,
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance",
              "product_revenue"
            ]
          }
        },
        "renterAccountId": {
          "description": "The renter account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "serviceFeeAmount": {
          "description": "Machine-owned 1% service fee computed from bookingFee; charged on top at funding",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        }
      },
      "id": "booking",
      "idPrefix": "book",
      "lifecycle": {
        "initial": "created",
        "states": [
          "created",
          "funding_1",
          "funding_2",
          "funding_3",
          "funded",
          "releasing_1",
          "releasing_2",
          "released",
          "cancelling_1",
          "cancelling_2",
          "cancelled",
          "abandoning_1",
          "abandoned",
          "abandoning_2"
        ],
        "transitions": {
          "abandon": {
            "from": [
              "created"
            ],
            "to": "abandoned"
          },
          "cancel": {
            "from": [
              "funded"
            ],
            "to": "cancelling_1"
          },
          "collect_service_fee": {
            "from": [
              "funding_3"
            ],
            "to": "funded"
          },
          "confirm_delivery": {
            "from": [
              "funded"
            ],
            "to": "releasing_1"
          },
          "fund_piece_1": {
            "from": [
              "created"
            ],
            "to": "funding_1"
          },
          "fund_piece_2": {
            "from": [
              "funding_1"
            ],
            "to": "funding_2"
          },
          "fund_piece_3": {
            "from": [
              "funding_2"
            ],
            "to": "funding_3"
          },
          "refund_piece_2": {
            "from": [
              "cancelling_1"
            ],
            "to": "cancelling_2"
          },
          "refund_piece_3": {
            "from": [
              "cancelling_2"
            ],
            "to": "cancelled"
          },
          "release_piece_2": {
            "from": [
              "releasing_1"
            ],
            "to": "releasing_2"
          },
          "release_piece_3": {
            "from": [
              "releasing_2"
            ],
            "to": "released"
          },
          "unfund_piece_1": {
            "from": [
              "funding_1",
              "abandoning_1"
            ],
            "to": "abandoned"
          },
          "unfund_piece_2": {
            "from": [
              "funding_2",
              "abandoning_2"
            ],
            "to": "abandoning_1"
          },
          "unfund_piece_3": {
            "from": [
              "funding_3"
            ],
            "to": "abandoning_2"
          }
        }
      },
      "parties": {
        "beneficiary": "companyAccountId",
        "payer": "renterAccountId"
      },
      "partitions": [
        {
          "pieceFields": [
            "piece1Amount",
            "piece2Amount",
            "piece3Amount"
          ],
          "totalField": "bookingFee"
        }
      ],
      "required": [
        "renterAccountId",
        "companyAccountId",
        "platformAccountId",
        "bookingFee",
        "piece1Amount",
        "piece2Amount",
        "currency"
