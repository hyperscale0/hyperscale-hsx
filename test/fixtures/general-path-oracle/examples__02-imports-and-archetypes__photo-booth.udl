          "steps": [],
          "summary": "Fund piece 2 of the held amount into escrow"
        },
        "fund_piece_3": {
          "agentDescription": "Move piece 3 of the split amount from the renter into escrow. Pieces 1 and 2 must be in escrow first. It debits the renter for real. Where the product charges a percentage payer fee, one more call collects that fee before the hold counts as funded.",
          "effects": {
            "moves": [
              {
                "signature": "moves.collection.pay_in",
                "source": "moves[0]"
