      },
      "agentDescription": "Reach for tutor payout when the school funds one period total that is then split across 2 fixed recipients by stored share amounts. Callers fund the pool one share at a time. Each recipient's payout fires from the stored payout date, not from a call.",
      "description": "Pooled split: the school pools the period's weeklyPool share by share; the pool distributes to every recipient in full on the stored payout date",
      "fields": {
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "leadTutorAccountId": {
          "description": "The lead tutor account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "leadTutorShareAmount": {
          "description": "55% of weeklyPool (carries the integer-division remainder): the lead tutor's share. Computed as floor(weeklyPool * 5500 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "payoutDate": {
          "description": "The period's payout date; the pool distributes from it",
          "format": "hyperscale-date-time",
          "type": "string"
        },
        "schoolAccountId": {
          "description": "The school account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "tutorAccountId": {
          "description": "The tutor account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "tutorShareAmount": {
          "description": "45% of weeklyPool: the tutor's share. Computed as floor(weeklyPool * 4500 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "weeklyPool": {
          "description": "The pooled period total in SAR minor units; the share fields below partition it exactly",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        }
      },
      "id": "tutor_payout",
      "idPrefix": "tp",
      "lifecycle": {
        "initial": "created",
        "states": [
          "created",
          "pooling_1",
          "pooled",
          "distributing_1",
          "distributed"
        ],
        "transitions": {
          "distribute_share_1": {
            "from": [
              "pooled"
            ],
            "to": "distributing_1"
          },
          "distribute_share_2": {
            "from": [
              "distributing_1"
            ],
            "to": "distributed"
          },
          "fund_share_1": {
            "from": [
              "created"
            ],
            "to": "pooling_1"
          },
          "fund_share_2": {
            "from": [
              "pooling_1"
            ],
            "to": "pooled"
          }
        }
      },
      "parties": {
        "beneficiary": "leadTutorAccountId",
        "payer": "schoolAccountId"
      },
      "partitions": [
        {
          "pieceFields": [
            "leadTutorShareAmount",
            "tutorShareAmount"
          ],
          "totalField": "weeklyPool"
        }
      ],
      "required": [
        "schoolAccountId",
        "leadTutorAccountId",
        "tutorAccountId",
        "weeklyPool",
        "payoutDate",
        "leadTutorShareAmount",
        "tutorShareAmount",
        "currency"
      ],
      "summary": "Period pool from school split 2 ways",
      "title": "Tutor payout"
    }
  ],
