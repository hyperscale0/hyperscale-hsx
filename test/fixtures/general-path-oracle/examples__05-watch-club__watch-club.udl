          "steps": [],
          "summary": "Reserve both cross-payments for the whole-trade clawback window"
        }
      },
      "agentDescription": "Reach for swap when two named parties pay each other in one atomic trade and neither leg may settle alone. Both principals fund one escrow together, both cross-payments reserve together, and one dispute unwinds both. A single payer paying a single payee is instant transfer instead.",
      "description": "Atomic swap between member and seller; half-funded and half-released states do not exist",
      "distinctParties": true,
      "feeRules": [
        {
          "amountField": "memberTradeFee",
          "baseField": "memberPays",
          "bearerField": "memberAccountId",
          "position": "on_top",
          "rule": {
            "currencyField": "currency",
            "field": "memberTradeFee",
            "kind": "exact"
          }
        },
        {
          "amountField": "sellerTradeFee",
          "baseField": "sellerPays",
          "bearerField": "sellerAccountId",
          "position": "on_top",
          "rule": {
            "currencyField": "currency",
            "field": "sellerTradeFee",
            "kind": "exact"
          }
        }
      ],
      "fields": {
        "clawbackAt": {
          "description": "Machine-owned end of the P14D whole-trade dispute window",
          "format": "hyperscale-date-time",
          "type": "string"
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "memberAccountId": {
          "description": "The member account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "memberPays": {
          "description": "Side A amount in SAR minor units, held against the whole trade",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "memberTradeFee": {
          "description": "Immutable exact member service fee in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "platformAccountId": {
          "description": "The product fee collection account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-fee-collection-port": true,
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance",
              "product_revenue"
            ]
          }
        },
        "sellerAccountId": {
          "description": "The seller account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "sellerPays": {
          "description": "Side B amount in SAR minor units, held against the whole trade",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "sellerTradeFee": {
          "description": "Immutable exact seller service fee in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        }
      },
      "id": "member_trade",
      "idPrefix": "mt",
      "lifecycle": {
        "initial": "created",
        "states": [
          "created",
          "abandoned",
          "funded",
          "cancelled",
          "released",
          "settled",
          "clawed_back"
        ],
        "transitions": {
          "abandon": {
            "from": [
              "created"
            ],
            "to": "abandoned"
          },
          "cancel": {
            "from": [
              "funded"
            ],
            "to": "cancelled"
          },
          "dispute": {
            "from": [
              "released"
            ],
            "to": "clawed_back"
          },
          "fund": {
            "from": [
              "created"
            ],
            "to": "funded"
          },
          "post": {
            "from": [
              "released"
            ],
            "to": "settled"
          },
          "release": {
            "from": [
              "funded"
            ],
            "to": "released"
          }
        }
      },
      "parties": {
        "beneficiary": "sellerAccountId",
        "payer": "memberAccountId"
      },
      "required": [
        "memberAccountId",
        "sellerAccountId",
        "platformAccountId",
        "memberPays",
        "sellerPays",
        "memberTradeFee",
        "sellerTradeFee",
        "currency"
      ],
      "summary": "Two-party atomic trade between member and seller",
      "title": "Member trade"
    },
    {
      "actionOrder": [
        "create",
        "close",
        "calculate",
        "approve",
        "instruct",
        "acknowledge_payout",
        "reconcile"
      ],
      "actions": {
        "acknowledge_payout": {
          "agentDescription": "Record the beneficiary confirmation that the payout landed, with the reference kept in the receipt. The batch must already be instructed. Only the payout destination may call it. No money moves.",
          "captureInput": {
            "acknowledgementReference": "acknowledgementReference"
          },
          "effects": {
            "decides": [
              {
                "signature": "decides.tenant_port",
                "source": "port"
              }
            ]
          },
          "input": {
            "additionalProperties": false,
            "properties": {
              "acknowledgementReference": {
                "description": "Required decision reference retained in the operation receipt",
                "maxLength": 180,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "acknowledgementReference"
            ],
            "type": "object"
          },
          "moves": [],
          "port": {
            "allowedParties": [
              "beneficiary"
            ]
          },
          "publicAction": "acknowledgePayoutSellerPayout",
          "steps": [],
          "summary": "Record the tenant's payout acknowledgement in the receipt"
        },
        "approve": {
          "agentDescription": "Sign off on the frozen net payable. The batch must already be calculated. Nothing is recomputed and no money moves. This is the gate instruct waits on.",
          "moves": [],
          "publicAction": "approveSellerPayout",
          "steps": [],
          "summary": "Approve the frozen payable without recomputing it"
        },
        "calculate": {
          "agentDescription": "Prove and freeze the one net payable from gross captures plus credit adjustments minus debit adjustments. The batch must be closed first. A zero or negative net is refused, so a batch in deficit never reaches a payout. No money moves.",
          "moves": [],
          "publicAction": "calculateSellerPayout",
          "signedSum": {
            "amountRef": "netPayable",
            "onNegative": "refuse",
            "onZero": "refuse",
            "sources": [
              {
                "amountField": "amount",
                "instrumentId": "seller_payout_capture_entry",
                "refField": "sellerPayoutId",
                "sign": "add",
                "statuses": [
                  "accrued"
                ],
                "subtotalRef": "grossCaptureAmount"
              },
              {
                "amountField": "amount",
                "instrumentId": "seller_payout_credit_adjustment",
                "refField": "sellerPayoutId",
                "sign": "add",
                "statuses": [
                  "applied"
                ],
                "subtotalRef": "creditAdjustmentAmount"
              },
              {
                "amountField": "amount",
                "instrumentId": "seller_payout_debit_adjustment",
                "refField": "sellerPayoutId",
                "sign": "subtract",
                "statuses": [
                  "applied"
                ],
                "subtotalRef": "debitAdjustmentAmount"
              }
            ]
          },
          "steps": [],
          "summary": "Prove and freeze the one signed net payable amount"
        },
        "close": {
          "due": {
            "field": "closeAt"
          },
          "effects": {
            "schedules": [
              {
                "signature": "schedules.due",
                "source": "due"
              }
            ]
          },
          "moves": [],
          "steps": [],
          "summary": "Freeze the batch and stop all new entries"
        },
        "create": {
          "agentDescription": "Open a batch that capture entries and adjustments can accrue into. No money moves. The batch keeps taking entries until its close date freezes it.",
          "moves": [],
          "publicAction": "createSellerPayout",
          "steps": [],
          "summary": "Open a seller payout"
        },
        "instruct": {
          "agentDescription": "Create one external payout for the frozen net payable, drawn on the settlement account and sent to the stored beneficiary. The batch must be approved. This moves money off the platform and is idempotent, so a retry never pays twice.",
          "effects": {
            "moves": [
              {
                "signature": "moves.payout.external",
                "source": "payout"
              }
            ]
          },
