          },
          "approve": {
            "from": [
              "calculated"
            ],
            "to": "approved"
          },
          "calculate": {
            "from": [
              "closed"
            ],
            "to": "calculated"
          },
          "close": {
            "from": [
              "open"
            ],
            "to": "closed"
          },
          "instruct": {
            "from": [
              "approved"
            ],
            "to": "instructed"
          },
          "reconcile": {
            "from": [
              "instructed",
              "acknowledged"
            ],
            "to": "reconciled"
          }
        }
      },
      "parties": {
