          "summary": "Collect repayment 3 of 3"
        },
        "create": {
          "agentDescription": "Open the advance row before any money moves. The caller supplies the advanceAmount, the fee amount, the repayable total, and the first repayment date. The repayment fields must partition the repayable total exactly. Nothing is disbursed here.",
          "moves": [],
          "publicAction": "createAgencyAdvance",
          "steps": [],
          "summary": "Create a agency advance"
        },
        "disburse": {
          "agentDescription": "Pay the advanceAmount from the lender to the agency and start the repayment schedule. The advance must be created. The transfer posts straight out and does not unwind. Each repayment is collected on its own stored date anchor.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.advanceAmount"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.agencyAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "agency_advance"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "disburse"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "fields.lenderAccountId"
                }
              },
              "capture": {
                "disburseTransferTransferId": "transferId"
              },
              "key": "transfer",
              "operation": "internal_transfer.create"
            }
          ],
          "publicAction": "disburseAgencyAdvance",
          "steps": [],
          "summary": "Disburse the advanceAmount to the agency"
        }
      },
      "agentDescription": "Reach for advance when the lender pays the agency up front and is repaid afterwards, either out of a carved hold release or over scheduled repayments. Pick deposit for a refundable reservation and instant transfer when nobody repays the payer.",
      "description": "Advance: the lender disburses advanceAmount to the agency, repaid over 3 scheduled repayments plus the funder's discount",
      "fields": {
        "advanceAmount": {
          "description": "The advanced amount in SAR minor units, disbursed to the agency up front",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "agencyAccountId": {
          "description": "The agency account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "feeAmount": {
          "description": "3% of advanceAmount, the funder's discount repaid on top of the advance",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "firstRepaymentDue": {
          "description": "Due date of the first repayment; repayment k falls P2W after its predecessor",
          "format": "hyperscale-date-time",
          "type": "string"
        },
        "lenderAccountId": {
          "description": "The lender account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "repayableAmount": {
          "description": "advanceAmount + feeAmount: the total the repayment fields below partition exactly",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "repayment1Amount": {
