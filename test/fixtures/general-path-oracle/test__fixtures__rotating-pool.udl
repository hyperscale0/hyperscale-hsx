      },
      "agentDescription": "Reach for rotating pool when a fixed group pays the same contribution every cycle and one member takes the whole pot each cycle, in a declared order. The roster freezes at creation, one contribution row per member, and the pot rotates until every member has been paid. Scheduled is the one payer, one payee shape on a calendar.",
      "description": "Fixed rotating contribution and payout order",
      "fields": {
        "contributionAmount": {
          "description": "Exact contribution in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "firstContributionAt": {
          "description": "Stored first contribution due date",
          "format": "hyperscale-date-time",
          "type": "string"
        },
        "guaranteeSourceAccountId": {
          "description": "The guarantee source account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "memberAAccountId": {
          "description": "The member a account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "memberBAccountId": {
          "description": "The member b account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "memberCAccountId": {
          "description": "The member c account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "one": {
          "const": 1,
          "description": "Exact fixed member-row count",
          "type": "integer"
        }
      },
      "id": "pool",
      "idPrefix": "pool",
      "lifecycle": {
        "initial": "forming",
        "states": [
          "forming",
          "cancelled",
          "active_cycle_1",
          "cycle_1_ready",
          "active_cycle_2",
          "cycle_2_ready",
          "active_cycle_3",
          "cycle_3_ready",
          "completed"
        ],
        "transitions": {
          "activate": {
            "from": [
              "forming"
            ],
            "to": "active_cycle_1"
          },
          "advance_cycle_1": {
            "from": [
              "cycle_1_ready"
            ],
            "to": "active_cycle_2"
          },
          "advance_cycle_2": {
            "from": [
              "cycle_2_ready"
            ],
            "to": "active_cycle_3"
          },
          "advance_cycle_3": {
            "from": [
              "cycle_3_ready"
            ],
            "to": "completed"
          },
          "cancel": {
            "from": [
              "forming"
            ],
            "to": "cancelled"
          },
          "ready_cycle_1": {
            "from": [
              "active_cycle_1"
            ],
            "to": "cycle_1_ready"
          },
          "ready_cycle_2": {
            "from": [
              "active_cycle_2"
            ],
            "to": "cycle_2_ready"
          },
          "ready_cycle_3": {
            "from": [
              "active_cycle_3"
            ],
            "to": "cycle_3_ready"
          }
        }
      },
      "parties": {
        "payer": "guaranteeSourceAccountId"
      },
      "required": [
        "memberAAccountId",
        "memberBAccountId",
        "memberCAccountId",
        "guaranteeSourceAccountId",
        "currency",
        "contributionAmount",
        "firstContributionAt",
        "one"
      ],
      "summary": "3-member rotating pool",
      "title": "Pool"
    },
    {
      "actionOrder": [
        "create",
        "contribute_cycle_1",
        "mark_default_cycle_1",
        "guarantee_cycle_1",
        "pay_cycle_1",
        "pay_guaranteed_cycle_1",
        "contribute_cycle_2",
        "mark_default_cycle_2",
        "guarantee_cycle_2",
        "pay_cycle_2",
        "pay_guaranteed_cycle_2",
        "contribute_cycle_3",
        "mark_default_cycle_3",
        "guarantee_cycle_3",
        "pay_cycle_3",
        "pay_guaranteed_cycle_3",
        "close"
      ],
      "actions": {
        "close": {
          "agentDescription": "Retire this member row after its final payout. Refused while the row escrow account still holds anything, so a row can never close over stranded money. No money moves.",
          "moves": [],
          "publicAction": "closePoolMemberAContribution",
          "requiresDrainedAccount": {
            "path": "refs.escrowAccountId"
          },
          "steps": [],
          "summary": "Complete after the final payout drains this member custody"
        },
        "contribute_cycle_1": {
          "due": {
            "field": "firstContributionAt"
          },
          "effects": {
            "moves": [
              {
                "signature": "moves.collection.pay_in",
                "source": "moves[0]"
              }
            ],
            "reads": [
              {
                "signature": "reads.requires_refs",
                "source": "requiresRefs"
              }
            ],
            "schedules": [
              {
                "signature": "schedules.due",
                "source": "due"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.contributionAmount"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "refs.escrowAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "pool_member_a_contribution"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "contribute_cycle_1"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "fields.memberAAccountId"
                }
              },
              "capture": {
                "contributeCycle1ContributionTransferId": "transferId"
              },
              "key": "contribution",
              "operation": "internal_transfer.create"
            }
          ],
          "requiresRefs": [
            {
              "field": "poolId",
              "statuses": [
                "active_cycle_1"
              ]
            }
          ],
          "steps": [],
          "summary": "Fund member a's cycle 1 contribution"
        },
        "contribute_cycle_2": {
          "due": {
            "field": "firstContributionAt",
            "offset": "P30D"
          },
          "effects": {
