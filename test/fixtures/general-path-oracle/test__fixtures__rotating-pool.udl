      "agentDescription": "One seat in the pool. The member a pays the same contribution every cycle and takes the whole pot on their turn. Every contribution, default, guarantee, and payout for that member happens on this row, never on the pool itself.",
      "description": "Fixed contribution row for member a",
      "fields": {
        "contributionAmount": {
          "description": "Exact contribution amount shared by every cycle",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "firstContributionAt": {
          "description": "First due anchor derived from the pool",
          "format": "hyperscale-date-time",
          "type": "string"
        },
        "guaranteeSourceAccountId": {
          "description": "The guarantee source account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "memberAAccountId": {
          "description": "The member a account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "memberBAccountId": {
          "description": "The member b account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "memberCAccountId": {
          "description": "The member c account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "poolId": {
          "description": "The exact pool",
          "pattern": "^pool_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        }
      },
      "id": "pool_member_a_contribution",
      "idPrefix": "zzaa",
      "lifecycle": {
        "initial": "cycle_1_due",
        "states": [
          "cycle_1_due",
          "cycle_1_funded",
          "cycle_1_defaulted",
          "cycle_1_guaranteed",
          "cycle_2_due",
          "cycle_2_funded",
          "cycle_2_defaulted",
          "cycle_2_guaranteed",
          "cycle_3_due",
          "cycle_3_funded",
          "cycle_3_defaulted",
          "cycle_3_guaranteed",
          "final_paid",
          "completed"
        ],
        "transitions": {
          "close": {
            "from": [
              "final_paid"
            ],
            "to": "completed"
          },
          "contribute_cycle_1": {
            "from": [
              "cycle_1_due"
            ],
            "to": "cycle_1_funded"
          },
          "contribute_cycle_2": {
            "from": [
              "cycle_2_due"
            ],
            "to": "cycle_2_funded"
          },
          "contribute_cycle_3": {
            "from": [
              "cycle_3_due"
            ],
            "to": "cycle_3_funded"
          },
          "guarantee_cycle_1": {
            "from": [
              "cycle_1_defaulted"
            ],
            "to": "cycle_1_guaranteed"
          },
          "guarantee_cycle_2": {
            "from": [
              "cycle_2_defaulted"
            ],
            "to": "cycle_2_guaranteed"
          },
          "guarantee_cycle_3": {
            "from": [
              "cycle_3_defaulted"
            ],
            "to": "cycle_3_guaranteed"
          },
          "mark_default_cycle_1": {
            "from": [
              "cycle_1_due"
            ],
            "to": "cycle_1_defaulted"
          },
          "mark_default_cycle_2": {
            "from": [
              "cycle_2_due"
            ],
            "to": "cycle_2_defaulted"
          },
          "mark_default_cycle_3": {
            "from": [
              "cycle_3_due"
            ],
            "to": "cycle_3_defaulted"
          },
          "pay_cycle_1": {
            "from": [
              "cycle_1_funded"
            ],
            "to": "cycle_2_due"
          },
          "pay_cycle_2": {
            "from": [
              "cycle_2_funded"
            ],
            "to": "cycle_3_due"
          },
          "pay_cycle_3": {
            "from": [
              "cycle_3_funded"
            ],
            "to": "final_paid"
          },
          "pay_guaranteed_cycle_1": {
            "from": [
              "cycle_1_guaranteed"
            ],
            "to": "cycle_2_due"
          },
          "pay_guaranteed_cycle_2": {
            "from": [
              "cycle_2_guaranteed"
            ],
            "to": "cycle_3_due"
          },
          "pay_guaranteed_cycle_3": {
            "from": [
              "cycle_3_guaranteed"
            ],
            "to": "final_paid"
          }
        }
      },
      "parties": {
        "beneficiary": "memberAAccountId",
        "payer": "guaranteeSourceAccountId"
      },
      "required": [
        "memberAAccountId",
        "guaranteeSourceAccountId",
        "memberBAccountId",
        "memberCAccountId",
        "contributionAmount",
        "currency",
        "firstContributionAt",
        "poolId"
      ],
      "summary": "member a contribution row",
      "title": "Pool Member a Contribution"
    },
