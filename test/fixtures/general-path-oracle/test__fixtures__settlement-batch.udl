      "id": "payout_batch_debit_adjustment",
      "idPrefix": "pbda",
      "lifecycle": {
        "initial": "created",
        "states": [
          "created",
          "applied"
        ],
        "transitions": {
          "adjust": {
            "from": [
              "created"
            ],
            "to": "applied"
          },
          "correct": {
            "from": [
              "created"
            ],
            "to": "applied"
          }
        }
      },
      "required": [
        "amount",
        "currency",
        "adjustmentReference",
