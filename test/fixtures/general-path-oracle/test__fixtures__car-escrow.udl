        },
        "release_piece_2": {
          "agentDescription": "Pay piece 2 out of escrow once the release decision has run. Its destination follows the product fee split, either the platform account or the seller. Money leaves escrow on this call and does not come back.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
