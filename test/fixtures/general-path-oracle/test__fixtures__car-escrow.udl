                }
              },
              "capture": {
                "fundPiece3TransferTransferId": "transferId"
              },
              "key": "transfer",
              "operation": "internal_transfer.create"
            }
          ],
          "publicAction": "fundPiece3Sale",
          "steps": [],
          "summary": "Fund piece 3 of the held amount into escrow"
        },
        "refund_piece_2": {
          "agentDescription": "Return piece 2 out of escrow once cancel has run. Its destination follows the product fee split, either the buyer or the seller. Money leaves escrow on this call and does not come back.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.piece2Amount"
