          "steps": [],
          "summary": "Release piece 3 of the held amount"
        },
        "unfund_piece_1": {
          "agentDescription": "Return piece 1 from escrow to the buyer and abandon the sale. It runs when only piece 1 was ever funded, or after the later pieces have already gone back. The settlement ends abandoned.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.piece1Amount"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.buyerAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "sale"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "unfund_piece_1"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "refs.escrowAccountId"
                }
              },
              "capture": {
                "unfundPiece1TransferTransferId": "transferId"
              },
              "key": "transfer",
              "operation": "internal_transfer.create"
            }
          ],
          "publicAction": "unfundPiece1Sale",
          "steps": [],
          "summary": "Return piece 1 to the buyer on abandonment"
        },
        "unfund_piece_2": {
          "agentDescription": "Return piece 2 from escrow to the buyer while abandoning a part-funded sale. Funding must have stopped at piece 2, or piece 3 must already be back. Piece 1 still has to be returned after this.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.piece2Amount"
                },
