          "publicAction": "unfundPiece3Sale",
          "steps": [],
          "summary": "Return piece 3 to the buyer on abandonment"
        }
      },
      "agentDescription": "Reach for sale when the buyer must commit money up front and nobody is paid until confirm_handover fires. Funding moves price into this settlement's own escrow account, where it stays until a release or an unwind pays it out. A straight-through payment with no custody step is a different shape.",
      "description": "Held payment: the buyer funds price into this settlement's own escrow; buyer confirms through confirm_handover to release",
      "feeRules": [
        {
          "amountField": "serviceFeeAmount",
          "baseField": "price",
          "bearerField": "buyerAccountId",
          "position": "on_top",
          "rule": {
            "bps": 100,
            "kind": "bps"
          }
        },
        {
          "amountField": "carvedFeeAmount",
          "baseField": "price",
          "bearerField": "sellerAccountId",
          "position": "carved",
          "rule": {
            "bps": 200,
            "kind": "bps"
          }
        }
      ],
      "fields": {
        "buyerAccountId": {
          "description": "The buyer account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "carvedFeeAmount": {
          "description": "Machine-owned total of the 2 carved platform fee pieces",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "piece1Amount": {
          "description": "98% of price (carries the integer-division remainder): released to the seller; on cancellation to the buyer. Computed as floor(price * 9800 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "piece2Amount": {
          "description": "1.5% of price: released to the platform; on cancellation to the buyer. Computed as floor(price * 150 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "piece3Amount": {
          "description": "0.5% of price: released to the platform; on cancellation to the seller. Computed as floor(price * 50 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "platformAccountId": {
          "description": "The product fee collection account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-fee-collection-port": true,
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance",
              "product_revenue"
            ]
          }
        },
        "price": {
          "description": "The gross held amount in SAR minor units; the piece fields below partition it exactly",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "sellerAccountId": {
          "description": "The seller account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "serviceFeeAmount": {
          "description": "Machine-owned 1% service fee computed from price; charged on top at funding",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        }
      },
      "id": "sale",
      "idPrefix": "sale",
      "lifecycle": {
        "initial": "created",
        "states": [
          "created",
          "funding_1",
          "funding_2",
          "funding_3",
          "funded",
          "releasing_1",
          "releasing_2",
          "released",
          "cancelling_1",
          "cancelling_2",
          "cancelled",
          "abandoning_1",
          "abandoned",
          "abandoning_2"
        ],
        "transitions": {
          "abandon": {
            "from": [
              "created"
            ],
            "to": "abandoned"
          },
          "cancel": {
            "from": [
              "funded"
            ],
            "to": "cancelling_1"
          },
          "collect_service_fee": {
            "from": [
              "funding_3"
            ],
            "to": "funded"
          },
          "confirm_handover": {
            "from": [
              "funded"
            ],
            "to": "releasing_1"
          },
          "fund_piece_1": {
            "from": [
              "created"
            ],
            "to": "funding_1"
          },
          "fund_piece_2": {
            "from": [
              "funding_1"
            ],
            "to": "funding_2"
          },
          "fund_piece_3": {
            "from": [
              "funding_2"
            ],
            "to": "funding_3"
          },
          "refund_piece_2": {
            "from": [
              "cancelling_1"
            ],
            "to": "cancelling_2"
          },
          "refund_piece_3": {
            "from": [
              "cancelling_2"
            ],
            "to": "cancelled"
          },
          "release_piece_2": {
            "from": [
              "releasing_1"
            ],
            "to": "releasing_2"
          },
          "release_piece_3": {
            "from": [
              "releasing_2"
            ],
            "to": "released"
          },
          "unfund_piece_1": {
            "from": [
              "funding_1",
              "abandoning_1"
            ],
            "to": "abandoned"
          },
          "unfund_piece_2": {
            "from": [
              "funding_2",
              "abandoning_2"
            ],
            "to": "abandoning_1"
          },
          "unfund_piece_3": {
            "from": [
              "funding_3"
            ],
            "to": "abandoning_2"
          }
        }
      },
      "parties": {
        "beneficiary": "sellerAccountId",
        "payer": "buyerAccountId"
      },
      "partitions": [
        {
          "pieceFields": [
            "piece1Amount",
            "piece2Amount",
            "piece3Amount"
          ],
          "totalField": "price"
        },
        {
          "pieceFields": [
            "piece2Amount",
            "piece3Amount"
          ],
          "totalField": "carvedFeeAmount"
        }
      ],
      "required": [
        "buyerAccountId",
        "sellerAccountId",
        "platformAccountId",
        "price",
        "piece1Amount",
        "piece2Amount",
        "piece3Amount",
        "currency"
      ],
      "summary": "Escrow-held payment from buyer to seller",
      "title": "Sale"
    }
  ],
