        },
        "refund_piece_3": {
          "agentDescription": "Return piece 3 out of escrow to the seller, which closes the cancellation. Piece 2 must be returned first. Money leaves escrow on this call and does not come back.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.piece3Amount"
