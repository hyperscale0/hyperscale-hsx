                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "refs.escrowAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "sale"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "fund_piece_2"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "fields.buyerAccountId"
                }
              },
              "capture": {
                "fundPiece2TransferTransferId": "transferId"
              },
              "key": "transfer",
              "operation": "internal_transfer.create"
            }
          ],
          "publicAction": "fundPiece2Sale",
          "steps": [],
          "summary": "Fund piece 2 of the held amount into escrow"
        },
        "fund_piece_3": {
          "agentDescription": "Move piece 3 of the split amount from the buyer into escrow. Pieces 1 and 2 must be in escrow first. It debits the buyer for real. Where the product charges a percentage payer fee, one more call collects that fee before the hold counts as funded.",
          "effects": {
            "moves": [
              {
                "signature": "moves.collection.pay_in",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
