      "agentDescription": "Reach for coverage when the buyer pays an insurance premium ahead of cover and the insurer must not be paid until the policy binds. The premium sits in this settlement's own escrow until confirm_policy fires. Binding then forwards 95% to the insurer and 5% to the platform.",
      "description": "Premium forward: the buyer funds the premium into this settlement's own escrow; binding through confirm_policy forwards it to the insurer exactly once, minus the platform commission",
      "fields": {
        "buyerAccountId": {
          "description": "The buyer account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "insurerAccountId": {
          "description": "The insurer account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "piece1Amount": {
          "description": "95% of premium (carries the integer-division remainder): released to the insurer. Computed as floor(premium * 9500 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "piece2Amount": {
          "description": "5% of premium: released to the platform. Computed as floor(premium * 500 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "platformAccountId": {
          "description": "The product fee collection account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-fee-collection-port": true,
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance",
              "product_revenue"
            ]
          }
        },
        "premium": {
          "description": "The gross held amount in SAR minor units; the piece fields below partition it exactly",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        }
      },
      "id": "coverage",
      "idPrefix": "cove",
      "lifecycle": {
        "initial": "created",
        "states": [
          "created",
          "funding_1",
          "funded",
          "releasing_1",
          "released",
          "abandoned"
        ],
        "transitions": {
          "abandon": {
            "from": [
              "created"
            ],
            "to": "abandoned"
          },
          "confirm_policy": {
            "from": [
              "funded"
            ],
            "to": "releasing_1"
          },
          "forward_piece_2": {
            "from": [
              "releasing_1"
            ],
            "to": "released"
          },
          "fund_piece_1": {
            "from": [
              "created"
            ],
            "to": "funding_1"
          },
          "fund_piece_2": {
            "from": [
              "funding_1"
            ],
            "to": "funded"
          },
          "unfund_piece_1": {
            "from": [
              "funding_1"
            ],
            "to": "abandoned"
          }
        }
      },
      "parties": {
        "beneficiary": "insurerAccountId",
        "payer": "buyerAccountId"
      },
      "partitions": [
        {
          "pieceFields": [
            "piece1Amount",
            "piece2Amount"
          ],
          "totalField": "premium"
        }
      ],
      "required": [
        "buyerAccountId",
        "insurerAccountId",
        "platformAccountId",
        "premium",
        "piece1Amount",
        "piece2Amount",
        "currency"
      ],
      "summary": "Premium held for the insurer until the policy binds",
      "title": "Coverage"
    },
    {
      "actionOrder": [
        "create",
        "place_deposit",
        "assess_vehicle",
        "return_deposit"
      ],
      "actions": {
        "assess_vehicle": {
          "agentDescription": "Claim the held deposit for the seller. The deposit must be in held. The reservation settles here, whole or up to the decided amount with the exact remainder released back to the buyer. There is no return afterwards.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "transferId": {
                  "from": "instance",
                  "path": "refs.placeDepositReservationTransferId"
                }
              },
              "key": "post",
              "operation": "internal_transfer.post"
            }
          ],
          "publicAction": "assessVehicleTestDriveDeposit",
          "steps": [],
          "summary": "Claim the deposit for the seller through assess_vehicle"
        },
        "create": {
          "agentDescription": "Open the deposit row before anything is reserved. The caller supplies the depositAmount, the currency, and the buyer and seller accounts. Nothing is reserved yet, call place deposit next.",
          "moves": [],
          "publicAction": "createTestDriveDeposit",
          "steps": [],
          "summary": "Create a test drive deposit"
        },
        "place_deposit": {
          "agentDescription": "Reserve the depositAmount against the buyer's account in the seller's favor. The deposit must be created. The money is held, not paid: the claim posts it to the seller and the return releases it back.",
          "effects": {
            "holds": [
              {
                "signature": "holds.reserve",
                "source": "moves[0]"
              }
            ],
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.depositAmount"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.sellerAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "test_drive_deposit"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "place_deposit"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "fields.buyerAccountId"
                }
              },
              "capture": {
                "placeDepositReservationTransferId": "transferId"
              },
              "key": "reservation",
              "operation": "internal_transfer.reserve"
            }
          ],
          "publicAction": "placeDepositTestDriveDeposit",
          "steps": [],
          "summary": "Reserve the depositAmount against the buyer's account"
        },
        "return_deposit": {
          "agentDescription": "Return the held deposit to the buyer. The deposit must be in held and unclaimed. This releases the reservation whole and the seller receives nothing.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "reason": {
                  "from": "const",
                  "value": "Deposit returned in full"
                },
                "transferId": {
                  "from": "instance",
                  "path": "refs.placeDepositReservationTransferId"
                }
              },
              "key": "void",
              "operation": "internal_transfer.void"
            }
          ],
          "publicAction": "returnDepositTestDriveDeposit",
          "steps": [],
          "summary": "Return the deposit to the buyer through return_deposit"
        }
      },
      "agentDescription": "Reach for security deposit when money is reserved against the buyer in the seller's favor and later claimed or returned. The funds stay reserved and move only on the claim. Pick captured payment when the holder takes the money in slices, and instant transfer when nothing is held.",
      "description": "Deposit: the depositAmount is reserved against the buyer's account in the seller's favor, then claimed or returned in full",
      "fields": {
        "buyerAccountId": {
          "description": "The buyer account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "depositAmount": {
          "description": "The deposit amount in SAR minor units, reserved in full and fully accounted on claim or return",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "sellerAccountId": {
          "description": "The seller account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        }
      },
      "id": "test_drive_deposit",
      "idPrefix": "tdd",
      "lifecycle": {
        "initial": "created",
        "states": [
          "created",
          "held",
          "claimed",
          "returned"
        ],
        "transitions": {
          "assess_vehicle": {
            "from": [
              "held"
            ],
            "to": "claimed"
          },
          "place_deposit": {
            "from": [
              "created"
            ],
            "to": "held"
          },
          "return_deposit": {
            "from": [
              "held"
            ],
            "to": "returned"
          }
        }
      },
      "parties": {
        "beneficiary": "sellerAccountId",
        "payer": "buyerAccountId"
      },
      "required": [
        "buyerAccountId",
        "sellerAccountId",
        "depositAmount",
        "currency"
      ],
      "summary": "Refundable deposit from buyer held for seller",
      "title": "Test drive deposit"
    }
  ],
