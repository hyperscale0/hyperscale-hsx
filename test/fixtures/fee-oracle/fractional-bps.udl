        "unfund_piece_1": {
          "agentDescription": "Return piece 1 from escrow to the investor and abandon the subscription. It runs when only piece 1 was ever funded, or after the later pieces have already gone back. The settlement ends abandoned.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.piece1Amount"
                },
                "currency": {
