            "from": [
              "created"
            ],
            "to": "abandoned"
          },
          "cancel": {
            "from": [
              "funded"
            ],
            "to": "cancelling_1"
          },
          "collect_service_fee": {
            "from": [
              "funding_3"
            ],
            "to": "funded"
          },
          "confirm_transfer": {
            "from": [
              "funded"
            ],
            "to": "releasing_1"
          },
          "fund_piece_1": {
            "from": [
              "created"
            ],
            "to": "funding_1"
          },
          "fund_piece_2": {
            "from": [
              "funding_1"
            ],
            "to": "funding_2"
          },
          "fund_piece_3": {
            "from": [
              "funding_2"
            ],
            "to": "funding_3"
          },
          "refund_piece_2": {
            "from": [
              "cancelling_1"
            ],
            "to": "cancelling_2"
          },
          "refund_piece_3": {
            "from": [
              "cancelling_2"
            ],
            "to": "cancelled"
          },
          "release_piece_2": {
            "from": [
              "releasing_1"
            ],
            "to": "releasing_2"
          },
          "release_piece_3": {
            "from": [
              "releasing_2"
            ],
            "to": "released"
          },
          "unfund_piece_1": {
            "from": [
              "funding_1",
              "abandoning_1"
            ],
            "to": "abandoned"
          },
          "unfund_piece_2": {
            "from": [
              "funding_2",
              "abandoning_2"
            ],
            "to": "abandoning_1"
          },
          "unfund_piece_3": {
            "from": [
              "funding_3"
            ],
            "to": "abandoning_2"
          }
        }
      },
      "parties": {
