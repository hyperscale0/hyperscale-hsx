          "steps": [],
          "summary": "Return piece 2 to the investor on abandonment"
        },
        "unfund_piece_3": {
          "agentDescription": "Return piece 3 from escrow to the investor while abandoning a subscription funded as far as piece 3. Pieces 2 and 1 still have to be returned after this, in that order.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
