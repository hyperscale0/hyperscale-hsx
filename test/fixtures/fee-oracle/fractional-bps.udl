          "summary": "Return piece 3 to the investor on abandonment"
        }
      },
      "agentDescription": "Reach for subscription when the investor must commit money up front and nobody is paid until confirm_transfer fires. Funding moves subscriptionAmount into this settlement's own escrow account, where it stays until a release or an unwind pays it out. A straight-through payment with no custody step is a different shape.",
      "description": "Held payment: the investor funds subscriptionAmount into this settlement's own escrow; gallery confirms through confirm_transfer to release",
      "feeRules": [
        {
          "amountField": "serviceFeeAmount",
          "baseField": "subscriptionAmount",
          "bearerField": "investorAccountId",
          "position": "on_top",
          "rule": {
            "bps": 100,
            "kind": "bps"
          }
        },
        {
          "amountField": "piece3Amount",
          "baseField": "subscriptionAmount",
          "bearerField": "galleryAccountId",
          "position": "carved",
          "rule": {
            "bps": 150,
            "kind": "bps"
          }
        }
      ],
      "fields": {
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "galleryAccountId": {
          "description": "The gallery account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "investorAccountId": {
          "description": "The investor account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "piece1Amount": {
          "description": "50% of subscriptionAmount (carries the integer-division remainder): released to the gallery; on cancellation to the investor. Computed as floor(subscriptionAmount * 5000 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "piece2Amount": {
          "description": "48.5% of subscriptionAmount: released to the gallery; on cancellation to the gallery. Computed as floor(subscriptionAmount * 4850 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "piece3Amount": {
          "description": "1.5% of subscriptionAmount: released to the platform; on cancellation to the gallery. Computed as floor(subscriptionAmount * 150 / 10000) in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "platformAccountId": {
          "description": "The product fee collection account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-fee-collection-port": true,
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance",
              "product_revenue"
            ]
          }
        },
        "serviceFeeAmount": {
          "description": "Machine-owned 1% service fee computed from subscriptionAmount; charged on top at funding",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "subscriptionAmount": {
          "description": "The gross held amount in SAR minor units; the piece fields below partition it exactly",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        }
      },
      "id": "subscription",
      "idPrefix": "subs",
      "lifecycle": {
        "initial": "created",
        "states": [
          "created",
          "funding_1",
          "funding_2",
          "funding_3",
          "funded",
          "releasing_1",
          "releasing_2",
