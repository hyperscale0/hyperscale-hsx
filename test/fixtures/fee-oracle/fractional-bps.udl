{
  "instruments": [
    {
      "actionOrder": [
        "fund_piece_2",
        "fund_piece_3",
        "collect_service_fee",
        "release_piece_2",
        "release_piece_3",
        "refund_piece_2",
        "refund_piece_3",
        "unfund_piece_1",
        "unfund_piece_2",
        "unfund_piece_3",
        "create",
        "fund_piece_1",
        "confirm_transfer",
        "cancel",
        "abandon"
      ],
      "actions": {
        "abandon": {
          "agentDescription": "Close a subscription that was never funded. The escrow account must be empty, so this refuses once any piece is in it. It moves no money and the settlement ends here with no way back.",
          "moves": [],
          "publicAction": "abandonSubscription",
          "requiresDrainedAccount": {
            "path": "refs.escrowAccountId"
          },
          "steps": [],
          "summary": "Abandon the settlement before any money is held"
        },
        "cancel": {
          "agentDescription": "Cancel the subscription and start returning the held money to the investor. It must be funded and not yet released. Cancellation is final, and a cancelled settlement never releases. Where the product sets a release deadline, this call is refused once that date passes.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.piece1Amount"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.investorAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "subscription"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "cancel"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "refs.escrowAccountId"
                }
              },
              "capture": {
                "cancelTransferTransferId": "transferId"
              },
              "key": "transfer",
              "operation": "internal_transfer.create"
            }
          ],
          "publicAction": "cancelSubscription",
          "steps": [],
          "summary": "Cancel the settlement and start the unwind"
        },
        "collect_service_fee": {
          "agentDescription": "Charge the investor the percentage service fee on top of the held amount and pay it to the platform account. All three funding pieces must be in escrow first. It debits the investor for real and it is the last step of funding.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.serviceFeeAmount"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.platformAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "subscription"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "collect_service_fee"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "fields.investorAccountId"
                }
              },
              "capture": {
                "collectServiceFeeTransferTransferId": "transferId"
              },
              "key": "transfer",
              "operation": "internal_transfer.create"
            }
          ],
          "publicAction": "collectServiceFeeSubscription",
          "steps": [],
          "summary": "Collect the payer-side service fee"
        },
        "confirm_transfer": {
          "agentDescription": "Confirm confirm_transfer and start paying the held money out of escrow. The subscription must be funded first, and the caller must be gallery. Where the product requires a decision reference, supply it here. Money leaves escrow on this call and does not come back.",
          "effects": {
            "decides": [
              {
                "signature": "decides.tenant_port",
                "source": "port"
              }
            ],
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.piece1Amount"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.galleryAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "subscription"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "confirm_transfer"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "refs.escrowAccountId"
                }
              },
              "capture": {
                "confirmTransferTransferTransferId": "transferId"
              },
              "key": "transfer",
              "operation": "internal_transfer.create"
            }
          ],
          "port": {
            "allowedParties": [
              "beneficiary"
            ]
          },
          "publicAction": "confirmTransferSubscription",
          "steps": [],
          "summary": "Confirm through confirm_transfer and start the release payout"
        },
        "create": {
          "agentDescription": "Open the subscription and provision the escrow account that holds the funds. This is the first call, and every funding and release action moves money through that account. It does not move the held amount itself.",
          "moves": [],
          "publicAction": "createSubscription",
          "steps": [
            {
              "bind": {
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "owner.id": {
                  "from": "instance",
                  "path": "productId"
                },
                "owner.type": {
                  "from": "const",
                  "value": "product"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "role": {
                  "from": "const",
                  "value": "product_escrow"
                }
              },
              "capture": {
                "escrowAccountId": "accountId"
              },
              "operation": "account.escrow.provision"
            }
          ],
          "summary": "Create a subscription settlement"
        },
        "fund_piece_1": {
          "agentDescription": "Move the investor's money into this settlement's escrow. Call it after create and before any release. It debits the investor for real, and where the product charges a payer-side fee that fee is taken on top in the same call. Only a later release or unwind moves the money again.",
          "effects": {
            "moves": [
              {
                "signature": "moves.collection.pay_in",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.piece1Amount"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "refs.escrowAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "subscription"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "fund_piece_1"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "fields.investorAccountId"
                }
              },
              "capture": {
                "fundPiece1TransferTransferId": "transferId"
              },
              "key": "transfer",
              "operation": "internal_transfer.create"
            }
          ],
          "publicAction": "fundPiece1Subscription",
          "steps": [],
          "summary": "Fund piece 1 of the held amount into escrow"
        },
        "fund_piece_2": {
          "agentDescription": "Move piece 2 of the split amount from the investor into escrow. Piece 1 must be in escrow first. It debits the investor for real, and the hold is still short of funded until piece 3 lands.",
          "effects": {
            "moves": [
              {
                "signature": "moves.collection.pay_in",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
