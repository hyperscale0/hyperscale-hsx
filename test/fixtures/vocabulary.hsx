program vocabulary "Vocabulary witnesses"
instrument cover {
  id_prefix: cvr;
  agent_description: "Freeze the signed dates and amounts before admitting slices.";
  fields {
    limitId: ref<limit>;
    start: date; end: date;
    minimumMissed { type: integer; minimum: 1; maximum: 1; }
    principal: money<SAR>; profit: money<SAR>;
    dates { type: text; items: {type: string; format: "hyperscale-date-time";}; minItems: 1; maxItems: 366; }
    earningRule { type: text; enum: [per_slice_on_due, on_disbursement]; }
  }
  date order: {before_field: start; after_field: end; operator: "<";};
  allocation: {slice_instrument_id: slice; slice_ref_field: coverId; slice_statuses: [open]; due_field: dueAt; position_field: position; earning_rule_field: earningRule;
    buckets: [
      {key: principal; source: {from: slice; amount_field: principal; destination_field: receiver;};},
      {key: profit; source: {from: slice; amount_field: profit; destination_field: receiver;};},
      {key: cost; source: {from: children; template: assessment; parameters: {cost: true;}; ref_field: sliceId; statuses: [open]; amount_field: amount; destination_field: receiver;};}
    ];
  };
  lifecycle {states open closed; initial open; on close: open -> closed; on write_off: open -> closed; on payoff: open -> closed;}
  action payoff {
    agent_description: "Compute this obligation's payoff from its remaining balances.";
    input: {type: object; additionalProperties: false; properties: {payerAccount: {type: string; pattern: "^acct_(sandbox|live)_[a-z0-9]{8,64}$";}; paymentIdentity: {type: string; minLength: 1;};}; required: [payerAccount, paymentIdentity];};
    allocate: {mode: payoff; source_account_field: payerAccount; payment_identity_field: paymentIdentity; capture: payoffReceipt;}; steps: [];
  }
  action write_off {agent_description: "Cancel this obligation without cash."; allocate: {mode: write_off; capture: loss;}; steps: [];}
  action create {agent_description: "Record the signed cover terms."; requires exposure: { amount_field: principal; anchor_field: limitId; cap_field: cap; cap_on_anchor: true; child_instrument_id: cover; statuses: [open]; measure: { allocation: principal; }; }; steps: [];}
  action close {
    agent_description: "Close when the declared count and schedule hold.";
    requires aggregate: {instrument_id: slice; ref_field: coverId; over: children; statuses: [closed]; check: {kind: count_at_least; target_field: minimumMissed;};};
    requires aggregate: {instrument_id: slice; ref_field: coverId; over: children; statuses: [open]; check: {kind: ordered; field: dueAt; position_field: position;};};
    requires aggregate: {instrument_id: slice; ref_field: coverId; over: children; statuses: [open]; check: {kind: schedule; dates_field: dates; date_field: dueAt; position_field: position; amounts: [{amount_field: principal; total_field: principal;},{amount_field: profit; total_field: profit;}]; remainder: first;};};
    steps: [];
  }
}
instrument slice {
  id_prefix: slc;
  agent_description: "Keep one premium and its signed interval.";
  fields {
    coverId: ref<cover>;
    start: date; end: date; dueAt: date;
    position {type: integer; minimum: 1; maximum: 366;}
    principal: money<SAR>; profit: money<SAR>; premium: money<SAR>;
    cost: money<SAR>; cap: money<SAR>;
    commission {type: money<SAR>; optional: true;}
    charge {type: money<SAR>; optional: true;}
    rate {type: integer; minimum: 500; maximum: 1000;}
    grace {type: text; enum: ["P3D", "P7D"];}
    kind {type: text; enum: [fine, cost];}
    receiver: account<SAR>;
  }
  computes derived: {field: commission; source_field: premium; rule: {kind: percentage_of; bps: {field: rate;};}; rounding: floor;};
  computes derived: {field: charge; source_field: cost; rule: {kind: minimum; cap_field: cap;}; rounding: floor;};
  lifecycle {states open closed; initial open; on close: open -> closed;}
  action create {
    agent_description: "Check both signed bounds and the assessment kind.";
    requires refs: {field: coverId; statuses: [open]; date_comparison: {local_path: "fields.start"; operator: ">="; referenced_path: "fields.start";}; unique: {namespace: assessment; by_fields: [kind];};};
    requires refs: {field: coverId; statuses: [open]; date_comparison: {local_path: "fields.end"; operator: "<="; referenced_path: "fields.end";};};
    steps: [];
  }
  action close {
    requires allocation: {ref_field: coverId; slice: self; buckets: [principal, profit]; check: settled;};
    due: {field: dueAt; offset: {field: grace;};};
    transitions refs: {field: coverId; action: close;};
    steps: [];
  }
}
instrument claim {
  id_prefix: clm;
  agent_description: "Refuse a claim while a sibling premium is unpaid past due.";
  fields {coverId: ref<cover>;}
  lifecycle {states open closed; initial open; on close: open -> closed;}
  action create {
    agent_description: "Read the cover's due premiums under the admission clock.";
    requires aggregate: {instrument_id: slice; anchor_field: coverId; ref_field: coverId; over: siblings; statuses: [open]; due_before: {field: dueAt;}; check: {kind: count_exactly; value: 0;};};
    steps: [];
  }
  action close {agent_description: "Close this claim."; steps: [];}
}
instrument payment {
  id_prefix: pmt;
  agent_description: "Allocate one identified payment through the obligation's bucket rules.";
  fields {coverId: ref<cover>; amount: money<SAR>; payer: account<SAR>; paymentIdentity {type: text; minLength: 1; maxLength: 128;}}
  lifecycle {states open closed; initial open; on close: open -> closed;}
  action create {agent_description: "Record one payment identity."; steps: [];}
  action close {
    agent_description: "Allocate this payment to outstanding debt once.";
    allocate: {ref_field: coverId; mode: payment; amount_field: amount; source_account_field: payer; payment_identity_field: paymentIdentity; capture: allocationReceipt;};
    steps: [];
  }
}
instrument joined_settlement {
  id_prefix: stlm;
  agent_description: "Fund one held balance from an immutable list and refund each origin.";
  fields {
    price: money<SAR>; buyerPart: money<SAR>; funderPart: money<SAR>; sellerNet: money<SAR>; sellerFee: money<SAR>; tax: money<SAR>; seller: account<SAR>; feeAccount: account<SAR>; taxAccount: account<SAR>;
    currency {type: text; const: "SAR";}
    contributions {type: text; minItems: 1; maxItems: 256;
      items: {type: object; additionalProperties: false; required: [amount, origin]; properties: {
        amount: {type: string; pattern: "^[1-9][0-9]{0,17}$"; "x-hyperscale-currency": "SAR";};
        origin: {type: string; pattern: "^acct_(sandbox|live)_[a-z0-9]{8,64}$";};
      };};
    }
  }
  contributions: {field: contributions; amount_key: amount; account_key: origin; total_field: price;};
  partitions: [{total_field: price; piece_fields: [buyerPart, funderPart];}, {total_field: price; piece_fields: [sellerNet, sellerFee, tax];}];
  lifecycle {states created funded refunded released; initial created; on fund: created -> funded; on refund: funded -> refunded; on release: funded -> released;}
  action create {agent_description: "Open the held account for these contributions.";
    steps: [{operation: "account.escrow.provision"; bind: {productId: {from: instance; path: productId;}; currency: {from: instance; path: "fields.currency";};}; capture: {hold: accountId;};}];
  }
  action fund {agent_description: "Fund all contributions together."; contribution stage: {stage: fund; account_path: "refs.hold";}; steps: [];}
  action refund {agent_description: "Refund all contributions to their original accounts."; contribution stage: {stage: refund; account_path: "refs.hold";}; steps: [];}
  action release {agent_description: "Release the complete seller, fee and tax partition."; moves: [{key: net; operation: "internal_transfer.create"; bind: {amount: {from: instance; path: "fields.sellerNet";}; sourceAccountId: {from: instance; path: "refs.hold";}; destinationAccountId: {from: instance; path: "fields.seller";}; currency: {from: instance; path: "fields.currency";}; productId: {from: instance; path: productId;};};}, {key: fee; operation: "internal_transfer.create"; bind: {amount: {from: instance; path: "fields.sellerFee";}; sourceAccountId: {from: instance; path: "refs.hold";}; destinationAccountId: {from: instance; path: "fields.feeAccount";}; currency: {from: instance; path: "fields.currency";}; productId: {from: instance; path: productId;};};}, {key: tax; operation: "internal_transfer.create"; bind: {amount: {from: instance; path: "fields.tax";}; sourceAccountId: {from: instance; path: "refs.hold";}; destinationAccountId: {from: instance; path: "fields.taxAccount";}; currency: {from: instance; path: "fields.currency";}; productId: {from: instance; path: productId;};};}]; steps: [];}
}
instrument payoff_remainder {
  id_prefix: rem;
  agent_description: "Subtract paid principal and cancelled profit from a fixed total.";
  fields {total: money<SAR>; paid: money<SAR>; rebate: money<SAR>; payer: account<SAR>; receiver: account<SAR>; currency {type: text; const: "SAR";}}
  parties {payer: payer; receiver: receiver;}
  lifecycle {states open closed; initial open; on close: open -> closed;}
  action create {agent_description: "Record immutable balances."; steps: [];}
  action close {agent_description: "Pay the positive remaining balance.";
    computes remainder: {total_path: "fields.total"; subtract_paths: ["fields.paid", "fields.rebate"]; amount_ref: remaining; on_zero: refuse;};
    moves: [{key: pay; operation: "internal_transfer.create"; bind: {amount: {from: instance; path: "refs.remaining";}; sourceAccountId: {from: instance; path: "fields.payer";}; destinationAccountId: {from: instance; path: "fields.receiver";}; currency: {from: instance; path: "fields.currency";}; productId: {from: instance; path: productId;};};}];
    steps: [];
  }
}
instrument allocation_refund {
  id_prefix: arfn;
  agent_description: "Refund one previously recorded allocation to its original payer.";
  fields {paymentId: ref<payment>; assessment {type: text; minLength: 1; maxLength: 128;}}
  lifecycle {states open closed; initial open; on close: open -> closed;}
  action create {agent_description: "Identify the original payment receipt."; steps: [];}
  action close {agent_description: "Refund the recorded assessment allocation once.";
    allocate: {ref_field: paymentId; mode: refund; action: close; assessment_field: assessment; capture: refundReceipt;}; steps: [];
  }
}

instrument limit {
  agent_description: "Keep one permanent cap per borrower and currency.";
  id_prefix: lim;
  fields { borrower: account<SAR>; currency { type: text; const: "SAR"; } cap: money<SAR>; }
  lifecycle { states open closed; initial open; on close: open -> closed; }
  action create { agent_description: "Claim this borrower and currency once."; unique: { namespace: borrower_limit; by_fields: [borrower, currency]; }; steps: []; }
  action close { agent_description: "Close the limit without releasing its subject claim."; steps: []; }
}

instrument assessment(cost: boolean) {
  id_prefix: prefix(instrument);
  agent_description: "One assessment selected by template and bound kind.";
  fields { sliceId: ref<slice>; coverId: ref<cover>; amount: money<SAR>; receiver: account<SAR>; }
  when_not(cost) {
    lifecycle {states open closed; initial open; on close: open -> closed;}
    action close {agent_description: "Close the assessment."; steps: [];}
  }
  when(cost) {
    lifecycle {states open paid refunded; initial open; on collect: open -> paid; on refund: paid -> refunded;}
    action collect {
      agent_description: "Collect this assessment's remaining balance.";
      input: {type: object; additionalProperties: false; properties: {paymentIdentity: {type: string; minLength: 1;};}; required: [paymentIdentity];};
      allocate: {mode: payment; ref_field: coverId; assessment: self; amount_field: amount; source_account_field: receiver; payment_identity_field: paymentIdentity; capture: collectionReceipt;}; steps: [];
    }
    action refund {agent_description: "Reverse this record's prior collection."; allocate: {mode: refund; action: collect; capture: refundReceipt;}; steps: [];}
  }
  action create {agent_description: "Record the assessment."; steps: [];}
}
instrument first_cost = assessment(cost: true)
instrument second_cost = assessment(cost: true)
instrument fine_only = assessment(cost: false)
