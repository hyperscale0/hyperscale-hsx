// A held payment with a zero-fee quoted cancellation: the cancellation stays
// quoted with a 0 bps charge and full refund to the buyer.

program zero_charge_vehicle_deal "Zero charge vehicle deal"

import { held_payment } from "std/money_flows"

party buyer: person
party seller: business

settlement deal = held_payment {
  payer: buyer
  payee: seller
  amount: price: money(SAR)
  release: port confirm_delivery
  fees { buyer: 2% }
  cancel_charge_bps: 0
  cancel_offer_life: PT30M
}

port confirm_delivery { allowed: [buyer] }
