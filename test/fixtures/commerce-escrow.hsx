// A commerce cooperative: instant checkout with asymmetric fees, a refundable
// rental deposit, and a weekly fulfillment pool split between the partners.
// Exercises instant_transfer, security_deposit, and pooled_split in one company.

program commerce_escrow "Commerce cooperative"

import { instant_transfer, security_deposit, pooled_split } from "std/settlements"

party shopper:  person
party merchant: business
party courier:  business
party packer:   business

asset order: good { title_transfer: off_platform }

settlement checkout = instant_transfer {
  payer:  shopper
  payee:  merchant
  amount: orderTotal: money(SAR)
  fees { shopper: 1%, merchant: 2% }
}

settlement rental_deposit = security_deposit {
  payer:  shopper
  holder: merchant
  amount: depositAmount: money(SAR)
  claim:  port assess_damage
  return: port release_deposit
}

settlement fulfillment_pool = pooled_split {
  payer:      merchant
  amount:     poolTotal: money(SAR)
  payout_due: payoutDate
  split { courier: 60%, packer: 40%, remainder_to: courier }
}

port assess_damage {
  allowed:    [merchant]
  shape:      { damageReport: text }
}

port release_deposit {
  allowed:    [merchant]
}
