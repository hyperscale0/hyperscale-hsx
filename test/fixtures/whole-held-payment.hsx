program whole_held_payment "Whole held payment"

import { held_payment } from "std/settlements"

party customer: person
party merchant: business

port approve_release { allowed: [customer] }

settlement custody_hold = held_payment {
  payer: customer
  payee: merchant
  amount: heldAmount: money(SAR)
  release: port approve_release | at(releaseDueAt)
  whole_amount: { enabled: true; }
  release_action: "approve"
  whole_fee: custodyFee: money(SAR)
  reference: orderReference
  id_prefix_override: "custody"
}
