// Retention financing. The contractor withholds part of every subcontractor
// invoice until the defects period ends; the subcontractor cannot wait that
// long, so a financier advances against the retention and is paid out of the
// very release the retention was withholding. The carve mints nothing: the
// contractor still funds one retained amount, the platform still takes its
// fee out of it, and the financier simply stands where the subcontractor
// stood when the release arrives. Exercises a fee-bearing, date-anchored,
// cancellable hold whose release is carved.

program financed_retention "Financed construction retention"

import { advance, held_payment, scheduled } from "settlement"

party contractor:    business
party subcontractor: business
party financier:     business

settlement retention = held_payment {
  payer:  contractor
  payee:  subcontractor
  amount: retainedAmount: money(SAR)
  fees { subcontractor: 1.5% }
  release: port approve_release | at(defectsPeriodEnd)
  on_cancel(funded) { contractor: 100% }
}

settlement financing = advance {
  funder:  financier
  to:      subcontractor
  amount:  advanceAmount: money(SAR)
  fee:     4%
  against: retention.release
}

// The retention can be refunded to the contractor instead of released, and a
// refund pays the financier nothing. That path is where this settlement earns
// its place: without it the program would finance a receivable it has no way
// to collect on.
settlement recourse = scheduled {
  payer:     subcontractor
  payee:     financier
  amount:    recourseAmount: money(SAR)
  count:     3
  every:     P30D
  first_due: recourseFirstDueAt
}

port approve_release {
  allowed: [contractor]
}
