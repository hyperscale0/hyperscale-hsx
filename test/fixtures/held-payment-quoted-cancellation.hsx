// A held payment whose cancellation carries a price: the charge the seller
// keeps and the refund the buyer gets back are quoted and frozen before either
// moves. The vehicle-deal shape, with a payer-side platform fee.

program quoted_vehicle_deal "Quoted vehicle deal"

import { held_payment } from "std/money_flows"

party buyer: person
party seller: business

settlement deal = held_payment {
  payer: buyer
  payee: seller
  amount: price: money(SAR)
  release: port confirm_delivery
  fees { buyer: 2% }
  cancel_charge_bps: 500
  cancel_offer_life: PT30M
}

port confirm_delivery { allowed: [buyer] }
