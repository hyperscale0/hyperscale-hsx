program captured_payment_program "Captured payment program"

import { captured_payment } from "std/money_flows"

party payer: person
party payee: business

settlement captured_payment = captured_payment {
  payer: payer
  payee: payee
  amount: total: money(SAR)
  reserve_until: reserveUntil
  correction: port correct_payment
  external_reversal: port reverse_payment within P120D
}

port correct_payment {
  allowed: [payee]
}

port reverse_payment {
  allowed: [payee]
  shape: { externalReference: text }
}
