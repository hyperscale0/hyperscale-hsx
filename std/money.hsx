header money

// Economics: Held funding and returns are principal. Release to the company realizes
// earnings; release to another participant passes the payer's cash through. Generic transfers, splits,
// schedules, swaps, boundary payouts and metered fees retain no assumed purpose.

// Expose each attachment's create and caller actions explicitly. A transfer or
// split pays once; a hold exposes fund, release and refund separately. Release
// pays payee and refund returns payer. A hold has no dispute or damage decision.
// The payee proposes a schedule, which creates its count occurrences, and only
// the payer activates or cancels it. Each due occurrence pays only while the
// schedule is active. A due time promises no retry.
// A pool accepts whole contributions only up to its remaining target and at most
// 366 paid records. Expose pay to release the exact target. Clock failure refunds
// original contributors; excess acceptance and partial contribution are absent.
// A swap reserves both legs before exchange or voids reservations on expiry.
// Payout instruct reserves across the selected adapter; confirm/reject require
// matching terminal instruction evidence. An acknowledgement cannot settle it.
// Metered bill charges a unique usage identity at the fixed unit price, only
// under an active mandate the payer created: bills stop at its expiresAt, and at
// most 366 billed events across every metered attachment on the mandate may sum
// their payer debit, buyer fee and tax included, to its limit. The payer revokes
// it to stop billing. Only the payee cancels its own unbilled usage.

// Cost: transfer.pay declares one transfer. Hold.create declares one owned account;
// fund, release and refund each declare one transfer. Schedules and pools add bounded
// child invocations. Run hsx cost on the composed program for counts, not riyal prices.

instrument transfer(payer: party, payee: party, amount: money = runtime) {
  summary: "One transfer between the bound parties."
  fields { amount: money = amount }
  lifecycle { states: [pending, paid, cancelled], initial: pending }
  action create { actor: { party: payer }, requires self.amount > "0" }
  action pay {
    from: pending, to: paid, actor: { party: payer }
    moves self.amount from payer to payee
  }
  action cancel { from: pending, to: cancelled, actor: { party: payer } }
}

instrument hold(payer: party, payee: party, amount: money = runtime) {
  summary: "Hold the declared amount until release or refund."
  fields { payer: account of payer, payee: account of payee, amount: money = amount, price: money = self.amount, held: account of self }
  lifecycle { states: [pending, funded, released, refunded, cancelled], initial: pending }
  action create { }
  action fund {
    from: pending, to: funded, actor: { party: payer }
    moves self.amount from payer to self.held economics { purpose: principal, sourceParty: payer }
  }
  action confirm {
    from: pending, to: funded
    requires self.held.balance == self.amount
  }
  action release {
    from: funded, to: released, actor: { party: payer }
    moves self.amount from self.held to payee economics { recipient: payee, company: { purpose: earning, sourceParty: payer }, participant: { purpose: pass_through, sourceParty: programOperator } }
  }
  action refund {
    from: funded, to: refunded, actor: { party: payee }
    moves self.amount from self.held to payer economics { purpose: principal, sourceParty: programOperator }
  }
  action cancel { from: pending, to: cancelled }
}

instrument split(payer: party, amount: money = runtime, shares: split = { programOperator: 100% }) {
  summary: "Split one amount; the last declared recipient receives the rounding remainder."
  fields { amount: money = amount }
  lifecycle { states: [pending, paid, cancelled], initial: pending }
  action create {}
  action pay { allowZero: true, requires self.amount > "0"; from: pending, to: paid, actor: { party: payer }, moves self.amount from payer shares shares }
  action cancel { from: pending, to: cancelled }
}

instrument schedule(payer: party, payee: party, amount: money = runtime, count: integer(1, 366) = 12) {
  summary: "A finite schedule whose dated pieces sum exactly to the declared total."
  fields { amount: money = amount, count: integer = count, dates: list(date, count) }
  lifecycle { states: [draft, active, complete, cancelled], initial: draft }
  action create {
    actor: { party: payee }
    invoke: [{ range: { count: { literal: count }, maximum: count, bind: position }, instrument: occurrence, action: create, input: { schedule: { field: self.id }, position: { field: position } } }]
  }
  action activate { from: draft, to: active, actor: { party: payer } }
  action complete {
    from: active, to: complete
    requires count of { instrument: occurrence, reference: "schedule", anchor: self.id, states: [pending], limit: 366 } == 0
  }
  action cancel { from: [draft, active], to: cancelled, actor: { party: payer } }
  records {
    occurrence: {
      fields {
        schedule: ref<parent>, position: integer(1, count), dueAt: date = at(self.schedule.dates, self.position)
        base: money = divide(self.schedule.amount, count)
        allocated: money = multiply(self.base, count)
        remainder: money = subtract(self.schedule.amount, self.allocated)
        first: integer = divide(1, self.position)
        adjustment: money = multiply(self.remainder, self.first)
        amount: money = sum(self.base, self.adjustment)
      }
      lifecycle { states: [pending, paid, cancelled], initial: pending }
      action create { actor: { parent: parent }, input { schedule: ref<parent>, position: integer(1, count) }, requires unique "scheduled_position" on [self.schedule, self.position] }
      action pay { allowZero: true, from: pending, to: paid, actor: clock, due: { at: self.dueAt }, requires self.schedule in [active], moves self.amount from payer to payee }
      action cancel { from: pending, to: cancelled, requires self.schedule in [cancelled] }
    }
  }
}

instrument pool(payer: party, payee: party, target: money, closes: date) {
  summary: "Contributions fund one threshold or return to their original contributor."
  fields { target: money = target, closesAt: date = closes, held: account of self }
  lifecycle { states: [open, paid, failed], initial: open }
  action create { }
  action pay {
    from: open, to: paid, actor: { party: payee }
    requires self.held.balance == self.target
    moves self.target from self.held to payee economics { recipient: payee, company: { purpose: earning, sourceParty: payer }, participant: { purpose: pass_through, sourceParty: programOperator } }
  }
  action fail {
    from: open, to: failed, actor: clock, due: { at: self.closesAt }
    requires self.held.balance < self.target
    invoke: [{ selection: { instrument: contribution, reference: "pool", anchor: self.id, states: [paid], limit: 366 }, action: refund, input: {} }]
  }
  records {
    contribution: {
      fields { pool: ref<parent>, payer: account of payer, amount: money, remaining: money? }
      lifecycle { states: [pending, paid, refunded], initial: pending }
      invariants count of { instrument: current(), reference: "pool", anchor: self.pool, states: [paid], limit: 366 } <= 366
      action create { requires self.pool in [open] }
      action pay { from: pending, to: paid, actor: { party: payer }, deadline: { at: self.pool.closesAt }, requires self.pool in [open], calculate: [{ target: remaining, op: subtract, base: { field: self.pool.target }, subtract: [{ field: self.pool.held.balance }] }], requires self.amount <= self.remaining, moves self.amount from self.payer to self.pool.held economics { purpose: principal, sourceParty: payer } }
      action refund { from: paid, to: refunded, actor: { parent: parent }, moves self.amount from self.pool.held to self.payer economics { purpose: principal, sourceParty: programOperator } }
    }
  }
}

instrument swap(first: party, second: party, first_amount: money, second_amount: money, expires: date) {
  summary: "Two reservations settle together or both return."
  fields { firstAmount: money = first_amount, secondAmount: money = second_amount, expiresAt: date = expires, firstReceipt: text?, secondReceipt: text? }
  lifecycle { states: [pending, first_ready, second_ready, both_ready, exchanged, cancelled], initial: pending }
  action create {}
  action fund_first { from: pending, to: first_ready, actor: { party: first }, deadline: { at: self.expiresAt }, moves reserve self.firstAmount from first to second capture "firstReceipt" }
  action fund_second { from: first_ready, to: both_ready, actor: { party: second }, deadline: { at: self.expiresAt }, moves reserve self.secondAmount from second to first capture "secondReceipt" }
  action start_second { from: pending, to: second_ready, actor: { party: second }, deadline: { at: self.expiresAt }, moves reserve self.secondAmount from second to first capture "secondReceipt" }
  action finish_first { from: second_ready, to: both_ready, actor: { party: first }, deadline: { at: self.expiresAt }, moves reserve self.firstAmount from first to second capture "firstReceipt" }
  action expire_second { from: second_ready, to: cancelled, actor: clock, due: { at: self.expiresAt }, moves void self.secondReceipt }
  action exchange { from: both_ready, to: exchanged, actor: { party: first }, moves post self.firstReceipt; moves post self.secondReceipt }
  action cancel { from: pending, to: cancelled }
  action expire_first { from: first_ready, to: cancelled, actor: clock, due: { at: self.expiresAt }, moves void self.firstReceipt }
  action expire_both { from: both_ready, to: cancelled, actor: clock, due: { at: self.expiresAt }, moves void self.firstReceipt; moves void self.secondReceipt }
}

instrument payout(payer: party, payee: party, adapter: text, amount: money = runtime) {
  summary: "Pay the recipient when the provider confirms settlement."
  fields { amount: money = amount }
  lifecycle { states: [pending, instructed, settled, rejected], initial: pending }
  action create {}
  action instruct {
    from: pending, to: instructed, actor: { party: payer }
    moves reserve self.amount from payer to payee boundary adapter
  }
  action confirm {
    from: instructed, to: settled
    moves post instruct
  }
  action reject {
    from: instructed, to: rejected
    moves void instruct
  }
}

instrument mandate(payer: party, payee: party) {
  summary: "A payer's permission for one payee to charge up to a total until it expires."
  fields { payer: account of payer, payee: account of payee, limit: money, expiresAt: date }
  lifecycle { states: [active, revoked], initial: active }
  action create { actor: { party: payer }, requires self.limit > "0" }
  action revoke { from: active, to: revoked, actor: { party: payer } }
}

instrument metered(payer: party, payee: party, unit_price: money, units: integer = 1, fee: fee = { seller: 0% }, mandate: ref<money.mandate> = object(money.mandate)) {
  summary: "A unique usage event priced once at the fixed unit price."
  fields { usageIdentity: text, mandate: ref<mandate>, payer: account of payer, payee: account of payee, unitPrice: money = unit_price, units: integer = units, amount: money = multiply(self.unitPrice, self.units) }
  lifecycle { states: [recorded, billed, cancelled], initial: recorded }
  invariants sum "bill_move1_debit" of { instrument: all(money.metered), reference: "mandate", anchor: self.mandate, states: [billed], limit: 366 } <= self.mandate.limit
  action create { requires unique "usage_event" on [self.usageIdentity]; requires self.mandate.payer == self.payer; requires self.mandate.payee == self.payee }
  action bill { allowZero: true, requires self.amount > "0"; from: recorded, to: billed, actor: { party: payee }, deadline: { at: self.mandate.expiresAt }, requires self.mandate in [active], moves self.amount from payer to payee fee fee }
  action cancel { from: recorded, to: cancelled, actor: { party: payee } }
}
