header escrow

// Economics: Funding and unspent returns are principal. Acceptance realizes earnings for
// the company; the payer's cash passes through to a bound outside seller, less the
// fee the company earns. Tax is pass-through.

// Expose create, fund, deliver and accept for the purchase path. Create captures
// subject.price; acceptance pays payee less the configured fee, not payer.
// Expose dispute, verify_return and refund separately for the return path.
// Payer disputes delivered goods; payee verifies return evidence from disputed.
// Refunds return the held balance to the payer. A composition can supply funding
// controllers and the states in which they block direct refunds. Only those
// controllers may confirm outside funding or finish its coordinated refund.
// Expose refund_undelivered to let the payer take the whole held price back once
// deliver_within has passed since funding without delivery. It is a payer action
// that becomes available at that time; nothing runs it automatically.
// The Product operator settles any disputed hold: settle_release pays the payee
// as acceptance would, and settle_return moves it to return_verified. Without a
// active funding controller, settle_return also runs settle_refund to return
// the whole balance to the payer. Otherwise the controller coordinates the
// return before the operator's settle_refund returns the rest.
// Acceptance expiry enters disputed, never released. Neither verify_return nor
// refund becomes public merely because dispute is exposed. Clock actions remain
// internal. Expose cancel for a pending hold, including a checkout-funded hold;
// it returns its credited balance to payer before cancelling. Confirm requires
// the whole captured price in held. This flow has no partial release or refund.

// Cost: create declares one owned account. Fund and refund each declare one
// transfer; accept expands the configured fee and tax into moves. Run hsx cost
// on the composed program for instruction counts. The executor supplies prices.

instrument hold(payer: party = party(person), payee: party = programOperator, accept_within: duration = 48h, deliver_within: duration = 14d, fee: fee = { seller: 0%, tax: 0% }, dispute: policy = { refund_after: return_verified }, funding: policy = { controllers: [], reference: "funds", blocking_states: [active] }) {
  revisioned: true
  summary: "Hold the subject price through delivery, acceptance and verified return."
  fields {
    payer: account of payer, payee: account of payee
    held: account of self, fundedAt: date?, deliverBy: date?, deliveredAt: date?, blockingFunding: integer?
    price: money = subject.price
  }
  lifecycle { states: [pending, funded, delivered, disputed, return_verified, released, refunded, cancelled], initial: pending }
  action create {
    subject { price: money }
    actor: { party: payer }
  }
  action fund {
    from: pending, to: funded, actor: { party: payer }
    set: { fundedAt: { field: self.now } }
    moves self.price from payer to self.held economics { purpose: principal, sourceParty: payer }
  }
  action confirm {
    from: pending, to: funded, actor: { parent: funding.controllers }
    requires self.held.balance == self.price
    calculate: [{ target: deliverBy, op: shift, date: { field: self.now }, milliseconds: { literal: deliver_within }, direction: after }]
  }
  action deliver {
    from: funded, to: delivered, actor: { party: payee }
    set: { deliveredAt: { field: self.now } }
  }
  action accept { allowZero: true, requires self.price > "0";
    from: delivered, to: released, actor: { party: payer }
    input { acceptanceReference: text }
    deadline: { at: self.deliveredAt, offset: accept_within }
    moves self.price from self.held to payee fee fee economics { payee: { recipient: payee, company: { purpose: earning, sourceParty: payer }, participant: { purpose: pass_through, sourceParty: programOperator } }, fee: { purpose: earning, sourceParty: payer }, tax: { purpose: pass_through, sourceParty: programOperator } }
  }
  action expire_acceptance {
    from: delivered, to: disputed, actor: clock
    due: { at: self.deliveredAt, offset: accept_within }
  }
  action dispute {
    from: delivered, to: disputed, actor: { party: payer }
    deadline: { at: self.deliveredAt, offset: accept_within }
  }
  action verify_return {
    from: disputed, to: return_verified, actor: { party: payee }
    input { returnEvidence: text }
  }
  action settle_release { allowZero: true, requires self.price > "0";
    from: disputed, to: released, actor: { party: programOperator }
    input { ruling: text }
    moves self.price from self.held to payee fee fee economics { payee: { recipient: payee, company: { purpose: earning, sourceParty: payer }, participant: { purpose: pass_through, sourceParty: programOperator } }, fee: { purpose: earning, sourceParty: payer }, tax: { purpose: pass_through, sourceParty: programOperator } }
  }
  action settle_return {
    from: disputed, to: return_verified, actor: { party: programOperator }
    input { ruling: text }
    calculate: [{ target: blockingFunding, op: aggregate, selection: { instrument: funding.controllers, reference: funding.reference, anchor: self.id, states: funding.blocking_states, limit: 1 }, measure: count }]
    invoke: [{ reference: self.id, action: settle_refund, guard: { kind: compare, left: { field: self.blockingFunding }, operator: "==", right: { literal: 0 } }, input: {} }]
  }
  action settle_refund { allowZero: true,
    from: return_verified, to: refunded, actor: { party: programOperator }
    requires count of { instrument: funding.controllers, reference: funding.reference, anchor: self.id, states: funding.blocking_states, limit: 1 } == 0
    moves self.held.balance from self.held to payer economics { purpose: principal, sourceParty: programOperator }
  }
  action refund {
    from: [funded, dispute.refund_after], to: refunded, actor: { party: payee }
    requires count of { instrument: funding.controllers, reference: funding.reference, anchor: self.id, states: funding.blocking_states, limit: 1 } == 0
    moves self.held.balance from self.held to payer economics { purpose: principal, sourceParty: programOperator }
  }
  action refund_undelivered {
    from: funded, to: refunded, actor: { party: payer }
    due: { at: self.fundedAt, offset: deliver_within }
    requires count of { instrument: funding.controllers, reference: funding.reference, anchor: self.id, states: funding.blocking_states, limit: 1 } == 0
    moves self.price from self.held to payer economics { purpose: principal, sourceParty: programOperator }
  }
  action finish_refund { allowZero: true,
    from: [funded, return_verified], to: refunded, actor: { parent: funding.controllers }
    moves self.held.balance from self.held to payer economics { purpose: principal, sourceParty: programOperator }
  }
  action cancel { allowZero: true,
    from: pending, to: cancelled, actor: { party: payer }
    moves self.held.balance from self.held to payer economics { purpose: principal, sourceParty: programOperator }
  }
}
