header insurance

// Economics: Company commission is earning; refunds reverse its captured transfer.
// Outside broker commissions and insurer premiums are pass-through.
// Claim moves remain unclassified until their money purpose is declared.

// Expose cover.create, activate and cancel separately. The adapter names a
// registered boundary adapter (conformance_boundary in sandbox). covers is an
// optional link to a sibling attachment; the attached object is already the
// insured thing. claim_limit is the sum insured: approved and paid claims on one
// cover, across every claim attachment, never total more. Activation binds adapter;
// each slice needs a separately created unique period and an active cover to collect.
// Collection debits holder for insurerPremium to the insurer and commission to
// broker as two moves. Broker defaults to programOperator; bind a declared business
// for a distinct agency. The two amounts sum to premium. Zero portions are allowed.
// Cover.cancel invokes refund only on paid slices, before each startsAt. It returns
// insurerPremium from insurer and commission from broker to holder. Active or
// expired periods are excluded; insufficient recipient funds refuse the reversal.
// Each refund is two transfers, so cancel refunds 126 paid slices per operation.
// A cover with more reads cancelling, and its cancel_step clock refunds the next
// 126 a second later until none remain; then it reads cancelled.
// Slice refund is parent-owned, not a public alias. Expose cover.cancel instead.
// Claims require active cover. Expose claim.create, approve, deny and pay as needed.
// Inspector approves OR denies from submitted. After approval only pay or clock
// expiry can consume the reservation; deny is never available after approval.
// Inspector is a bound party, not necessarily staff. These are ledger transfers;
// outside settlement needs the boundary protocol, not a claim of provider success.

// Cost: each slice collection or refund declares two transfers. Claim approval
// reserves once; pay posts once and expiry voids once. Cover cancellation adds
// at most 252 transfers per step. Run hsx cost for composed counts, not provider prices.

instrument cover(holder: party, adapter: text, commission: percent = 0%, broker: party = programOperator, covers: ref?, premium: money = runtime, claim_limit: money = runtime) {
  summary: "Recurring cover bound to an outside insurer across an ADL boundary."
  fields { covers: ref<covers>?, holder: account of holder, insurer: account(adapter(adapter), cash, "premium"), expiresAt: date, claimLimit: money = claim_limit, cancelAt: date?, slicesLeft: integer? }
  lifecycle { states: [pending, active, cancelling, cancelled, expired], initial: pending }
  action create { actor: { party: holder } }
  action activate {
    from: pending, to: active, actor: { party: programOperator }
    subject { adapter: adapter }
  }
  action cancel {
    from: active, to: cancelling, actor: { party: holder }
    invoke: [{ reference: self.id, action: cancel_batch, input: {} }]
  }
  action cancel_step { from: cancelling, to: preserve, actor: clock, due: { at: self.cancelAt }, invoke: [{ reference: self.id, action: cancel_batch, input: {} }] }
  action cancel_batch {
    from: cancelling, to: preserve, actor: { parent: current() }
    calculate: [{ target: cancelAt, op: shift, date: { field: self.now }, milliseconds: { literal: 1000 }, direction: after }]
    invoke: [{ selection: { instrument: slice, reference: "cover", anchor: self.id, states: [paid], limit: 126, batch: true, order: [startsAt] }, action: refund, input: {} }]
    invoke: [{ reference: self.id, action: cancel_check, input: {} }]
  }
  action cancel_check {
    from: cancelling, to: preserve, actor: { parent: current() }
    calculate: [{ target: slicesLeft, op: aggregate, selection: { instrument: slice, reference: "cover", anchor: self.id, states: [paid], limit: 1, batch: true }, measure: count }]
    invoke: [{ reference: self.id, action: finish_cancel, guard: { kind: compare, left: { field: self.slicesLeft }, operator: "==", right: { literal: 0 } }, input: {} }]
  }
  action finish_cancel { from: cancelling, to: cancelled, actor: { parent: current() } }
  action expire { from: active, to: expired, actor: clock, due: { at: self.expiresAt } }
  records {
    slice: {
      summary: "A whole premium period, collected once and refundable only before it starts."
      fields {
        cover: ref<parent>, premium: money = premium, startsAt: date, endsAt: date
        commission: money = rate(self.premium, commission)
        insurerPremium: money = subtract(self.premium, self.commission), commissionReceipt: text?
      }
      lifecycle { states: [pending, paid, active, expired, refunded], initial: pending }
      action create {
        requires self.startsAt < self.endsAt
        requires unique "premium_period" on [self.cover, self.startsAt, self.endsAt]
      }
      action collect {
        allowZero: true
        requires self.premium > "0"
        from: pending, to: paid, actor: { party: holder }
        requires self.cover in [active]
        moves self.insurerPremium from holder to self.cover.insurer economics { purpose: pass_through, sourceParty: holder }
        moves self.commission from holder to broker capture "commissionReceipt" economics { recipient: broker, company: { purpose: earning, sourceParty: holder }, participant: { purpose: pass_through, sourceParty: holder } }
      }
      action start { from: paid, to: active, actor: clock, due: { at: self.startsAt } }
      action expire { from: active, to: expired, actor: clock, due: { at: self.endsAt } }
      action refund {
        allowZero: true
        requires self.premium > "0"
        from: paid, to: refunded, actor: { parent: parent }, deadline: { at: self.startsAt }
        moves self.insurerPremium from self.cover.insurer to holder economics { purpose: pass_through, sourceParty: programOperator }
        moves self.commission from broker to holder economics { recipient: broker, company: { purpose: earning, sourceParty: broker, reversalOf: self.commissionReceipt }, participant: { purpose: pass_through, sourceParty: broker } }
      }
    }
  }
}

instrument claim(cover: ref<insurance.cover>, inspector: party) {
  summary: "A claim decision reserves one claim payment before settlement."
  fields { cover: ref<cover>, amount: money, expiresAt: date, evidence: text, reservation: text? }
  lifecycle { states: [submitted, approved, paid, denied, expired], initial: submitted }
  invariants sum "amount" of { instrument: all(insurance.claim), reference: "cover", anchor: self.cover, states: [approved, paid], limit: 366 } <= self.cover.claimLimit
  action create { requires self.cover in [active] }
  action approve {
    from: submitted, to: approved
    actor: { party: inspector }
    deadline: { at: self.expiresAt }
    moves reserve self.amount from self.cover.insurer to self.cover.holder capture "reservation"
  }
  action pay { from: approved, to: paid, actor: { party: inspector }, deadline: { at: self.expiresAt }, moves post self.reservation }
  action deny { from: submitted, to: denied, actor: { party: inspector } }
  action expire { from: approved, to: expired, actor: clock, due: { at: self.expiresAt }, moves void self.reservation }
}
