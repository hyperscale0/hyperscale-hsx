header travel

// Economics: Booking funds and refunds are principal. Supplier payments are payouts,
// tax is pass-through, and the company margin is earning. An outside operator
// receives a participant payout instead of company earnings.

// Publish a package before booking.create. Expose deposit, balance and confirm
// separately. Deposit needs pending premium slices whose cover is active, and
// collects those premiums in addition to booking cash. Balance is due by balanceAt.
// Expose cancel_early, cancel_middle and cancel_late for the desired booking paths.
// Early returns all held booking cash, whether deposit-only or fully paid. Middle
// returns held minus the original deposit; a deposit-only booking gets zero.
// Supplier penalty is based on supplierCost; tax applies to retained margin,
// and the bound operator receives the remainder. Late returns no buyer cash.
// Middle opens at earlyAt and ends at lateAt, which is middleAt plus 1ms; late
// starts there. Default_balance can already cancel a deposit_paid booking at
// balanceAt, after which no booking cancellation is reachable. Clock order matters.
// Booking refunds exclude insurance premiums, broker commission and all balances
// outside booking.held. Expose cover.cancel independently to refund eligible paid
// premium periods before startsAt; slice.refund is parent-owned. Active/expired
// premium periods remain excluded. Confirmation timeout returns the full booking
// price from paid only. A penalty above held cash or retained deposit refuses;
// this header does not subsidize a shortfall or reduce the configured penalty.

// Cost: booking.create declares one owned account. Deposit also invokes premium
// collections; cancellation declares the selected refund, penalty, tax and retained
// moves. Run hsx cost for bounded counts. Supplier penalties are business terms,
// not compiler or executor fees.

instrument package(price: money, supplier_cost: money, departure: date) {
  constraints { supplier_cost: at_most(price) }
  summary: "Immutable package price, supplier cost and departure."
  fields { price: money = price, supplierCost: money = supplier_cost, departure: date = departure }
  lifecycle { states: [draft, published, closed], initial: draft }
  action create { requires self.supplierCost <= self.price }
  action publish { from: draft, to: published }
  action close { from: published, to: closed, actor: clock, due: { at: self.departure } }
}

instrument booking(package: ref<travel.package>, buyer: party, supplier: party, operator: party = programOperator, cover: ref<insurance.cover>, deposit: percent = 30%, balance_before: duration = 14d, confirm_within: duration = 24h, tax: percent = 15%, early_before: duration = 30d, middle_before: duration = 15d, middle_penalty: percent = 10%, late_penalty: percent = 30%) {
  constraints { early_before: greater_than(middle_before) }
  summary: "A deposited booking with three cancellation bands and confirmation."
  fields {
    package: ref<package>, buyer: account of buyer, supplier: account of supplier
    price: money = self.package.price, supplierCost: money = self.package.supplierCost
    deposit: money = rate(self.price, deposit), balance: money = subtract(self.price, self.deposit)
    margin: money = subtract(self.price, self.supplierCost)
    tax: money = rate(self.margin, tax), operatorNet: money = subtract(self.margin, self.tax)
    middlePenalty: money = rate(self.supplierCost, middle_penalty)
    latePenalty: money = rate(self.supplierCost, late_penalty)
    balanceAt: date = before(self.package.departure, balance_before)
    earlyAt: date = before(self.package.departure, early_before)
    middleAt: date = before(self.package.departure, middle_before)
    lateAt: date = after(self.middleAt, 1ms)
    confirmBy: date = after(self.package.departure, confirm_within)
    held: account of self
    refund: money?, retainedMargin: money?, retainedTax: money?, retainedNet: money?
  }
  lifecycle { states: [created, deposit_paid, paid, completed, cancelled, refunded], initial: created }
  action create {
    requires self.package in [published]
  }
  action deposit { allowZero: true, requires self.price > "0";
    from: created, to: deposit_paid, actor: { party: buyer }, deadline: { at: self.balanceAt }
    requires count of { instrument: child(cover, slice), reference: "covers", anchor: self.id, states: [pending], limit: 366 } >= 1
    moves self.deposit from buyer to self.held economics { purpose: principal, sourceParty: buyer }
    invoke: [{ selection: { instrument: child(cover, slice), reference: "covers", anchor: self.id, states: [pending], limit: 366 }, action: collect, input: {} }]
  }
  action balance { allowZero: true, requires self.price > "0";
    from: deposit_paid, to: paid, actor: { party: buyer }, deadline: { at: self.balanceAt }
    moves self.balance from buyer to self.held economics { purpose: principal, sourceParty: buyer }
  }
  action confirm { allowZero: true, requires self.price > "0";
    from: paid, to: completed, actor: { party: operator }
    due: { at: self.package.departure }, deadline: { at: self.confirmBy }
    moves self.supplierCost from self.held to supplier economics { purpose: participant_payout, sourceParty: programOperator }
    moves self.tax from self.held to programTax economics { purpose: pass_through, sourceParty: programOperator }
    moves self.operatorNet from self.held to operator economics { recipient: operator, company: { purpose: earning, sourceParty: buyer }, participant: { purpose: participant_payout, sourceParty: programOperator } }
  }
  action timeout {
    from: paid, to: refunded, actor: clock, due: { at: self.confirmBy }
    moves self.price from self.held to buyer economics { purpose: principal, sourceParty: programOperator }
  }
  action cancel_early { allowZero: true, requires self.price > "0";
    from: [deposit_paid, paid], to: cancelled, actor: { party: buyer }, deadline: { at: self.earlyAt }
    moves self.held.balance from self.held to buyer economics { purpose: principal, sourceParty: programOperator }
  }
  action cancel_middle { allowZero: true, requires self.price > "0";
    from: [deposit_paid, paid], to: cancelled, actor: { party: buyer }, due: { at: self.earlyAt }, deadline: { at: self.lateAt }
    calculate: [
      { target: refund, op: "subtract", base: { field: self.held.balance }, subtract: [{ field: self.deposit }] }
      { target: retainedMargin, op: "subtract", base: { field: self.deposit }, subtract: [{ field: self.middlePenalty }] }
      { target: retainedTax, op: "rate", base: { field: self.retainedMargin }, bps: { literal: tax }, rounding: "floor" }
      { target: retainedNet, op: "subtract", base: { field: self.retainedMargin }, subtract: [{ field: self.retainedTax }] }
    ]
    moves self.refund from self.held to buyer economics { purpose: principal, sourceParty: programOperator }
    moves self.middlePenalty from self.held to supplier economics { purpose: participant_payout, sourceParty: programOperator }
    moves self.retainedTax from self.held to programTax economics { purpose: pass_through, sourceParty: programOperator }
    moves self.retainedNet from self.held to operator economics { recipient: operator, company: { purpose: earning, sourceParty: buyer }, participant: { purpose: participant_payout, sourceParty: programOperator } }
  }
  action cancel_late { allowZero: true, requires self.price > "0";
    from: [deposit_paid, paid], to: cancelled, actor: { party: buyer }, due: { at: self.lateAt }
    calculate: [
      { target: retainedMargin, op: "subtract", base: { field: self.held.balance }, subtract: [{ field: self.latePenalty }] }
      { target: retainedTax, op: "rate", base: { field: self.retainedMargin }, bps: { literal: tax }, rounding: "floor" }
      { target: retainedNet, op: "subtract", base: { field: self.retainedMargin }, subtract: [{ field: self.retainedTax }] }
    ]
    moves self.latePenalty from self.held to supplier economics { purpose: participant_payout, sourceParty: programOperator }
    moves self.retainedTax from self.held to programTax economics { purpose: pass_through, sourceParty: programOperator }
    moves self.retainedNet from self.held to operator economics { recipient: operator, company: { purpose: earning, sourceParty: buyer }, participant: { purpose: participant_payout, sourceParty: programOperator } }
  }
  action default_balance { allowZero: true, requires self.price > "0";
    from: deposit_paid, to: cancelled, actor: clock, due: { at: self.balanceAt }
    calculate: [
      { target: retainedMargin, op: "subtract", base: { field: self.held.balance }, subtract: [{ field: self.latePenalty }] }
      { target: retainedTax, op: "rate", base: { field: self.retainedMargin }, bps: { literal: tax }, rounding: "floor" }
      { target: retainedNet, op: "subtract", base: { field: self.retainedMargin }, subtract: [{ field: self.retainedTax }] }
    ]
    moves self.latePenalty from self.held to supplier economics { purpose: participant_payout, sourceParty: programOperator }
    moves self.retainedTax from self.held to programTax economics { purpose: pass_through, sourceParty: programOperator }
    moves self.retainedNet from self.held to operator economics { recipient: operator, company: { purpose: earning, sourceParty: buyer }, participant: { purpose: participant_payout, sourceParty: programOperator } }
  }
}
