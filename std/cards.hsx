header cards

// Activate holder and card before creating and approving an authorization.
// Expose authorization.create, approve and capture; expose decline and reverse
// separately if callers need those paths. Issuer declines only from pending;
// merchant captures or reverses an approved reservation. Expiry voids approved
// reservations or abandons pending ones; it does not delay a captured refund.
// Create one transaction for the captured authorization and expose its refund.
// Refund is available immediately from posted, even before authorization.expiresAt,
// and moves the whole captured amount from merchant to holder under programOperator.
// No partial capture, repeated capture or partial transaction refund is provided.
// Disputes need a posted transaction, issuer review and win before their deadline;
// win invokes the same refund. The alias never changes the declared action actor.

// Cost: authorization approve, capture and reverse each declare one transfer
// instruction. Transaction refund declares one transfer; a successful dispute
// invokes that refund. Card state changes alone declare no transfers.

instrument cardholder(holder: party) {
  summary: "An account holder whose card access can be activated, suspended or closed."
  fields { holder: account of holder }
  lifecycle { states: [pending, active, suspended, closed], initial: pending }
  action create {}
  action activate { from: pending, to: active }
  action suspend { from: active, to: suspended }
  action resume { from: suspended, to: active }
  action close { from: [active, suspended], to: closed }
}

instrument card(holder: ref<cards.cardholder>, spend_limit: money) {
  summary: "A card with a per-spend ceiling that can be activated, frozen or cancelled."
  fields { holder: ref<holder>, spendLimit: money = spend_limit }
  lifecycle { states: [issued, active, frozen, cancelled], initial: issued }
  action create { requires self.holder in [active] }
  action activate { from: issued, to: active, requires self.holder in [active] }
  action freeze { from: active, to: frozen }
  action unfreeze { from: frozen, to: active, requires self.holder in [active] }
  action cancel { from: [issued, active, frozen], to: cancelled }
}

instrument authorization(card: ref<cards.card>, merchant: party, issuer: party = programOperator) {
  summary: "Reserve a card payment for the merchant, then capture it or release the reservation."
  fields { card: ref<card>, merchant: account of merchant, amount: money, expiresAt: date, reservation: text? }
  lifecycle { states: [pending, approved, captured, declined, reversed, expired], initial: pending }
  action create {
    requires self.card in [active]
    requires self.card.holder in [active]
    requires self.amount <= self.card.spendLimit
  }
  action approve {
    from: pending, to: approved, actor: { party: issuer }, deadline: { at: self.expiresAt }
    requires self.card in [active]
    requires self.card.holder in [active]
    moves reserve self.amount from self.card.holder.holder to merchant capture "reservation"
  }
  action capture { from: approved, to: captured, actor: { party: merchant }, deadline: { at: self.expiresAt }, moves post self.reservation }
  action reverse { from: approved, to: reversed, actor: { party: merchant }, moves void self.reservation }
  action decline { from: pending, to: declined, actor: { party: issuer } }
  action expire { from: approved, to: expired, actor: clock, due: { at: self.expiresAt }, moves void self.reservation }
  action abandon { from: pending, to: expired, actor: clock, due: { at: self.expiresAt } }
}

instrument transaction(authorization: ref<cards.authorization>) {
  summary: "Record a captured card payment and return its amount when refunded."
  fields { authorization: ref<authorization>, amount: money = self.authorization.amount }
  lifecycle { states: [posted, refunded], initial: posted }
  action create { requires self.authorization in [captured]; requires unique "captured_authorization" on [self.authorization] }
  action refund {
    from: posted, to: refunded, actor: { party: programOperator }, input { reason: text }
    moves self.amount from self.authorization.merchant to self.authorization.card.holder.holder
  }
}

instrument dispute(transaction: ref<cards.transaction>, issuer: party = programOperator, within: duration = 90d) {
  summary: "Review a disputed card payment before its deadline and refund it when the dispute is won."
  fields { transaction: ref<transaction>, evidence: text, expiresAt: date = after(self.createdAt, within) }
  lifecycle { states: [filed, reviewing, won, lost], initial: filed }
  action create { requires self.transaction in [posted]; requires unique "disputed_transaction" on [self.transaction] }
  action review { from: filed, to: reviewing, actor: { party: issuer } }
  action win {
    from: reviewing, to: won, actor: { party: issuer }, deadline: { at: self.expiresAt }
    invoke: [{ reference: self.transaction, action: refund, input: { reason: { field: self.evidence } } }]
  }
  action lose { from: [filed, reviewing], to: lost, actor: clock, due: { at: self.expiresAt } }
}
