// Equipment rental holds a 1,000 SAR deposit for the customer who owns each rental.
// Return the deposit in full, or deduct a single 50 SAR late charge plus 7.50 SAR VAT.
program equipment_rental "Equipment rental deposits"

// Bind renter to the customer who owns this rental. The deposit has fee 0%
// and tax 0% because it stays refundable principal. The late service has 15% VAT.
instrument deposit(renter: party) {
  summary: "Hold security until return, with one disclosed late charge."
  fields {
    renter: account of renter
    held: account of self
    amount: money = 1000 SAR
    lateFee: money = 50 SAR
    lateTax: money = rate(self.lateFee, 15%)
    startsAt: date
    dueAt: date
    refund: money?
  }
  lifecycle { states: [pending, funded, returned, cancelled], initial: pending }
  action create {
    actor: { party: renter }
    requires self.dueAt > self.now
    requires self.startsAt > self.now
    requires self.dueAt > self.startsAt
  }
  action fund {
    from: pending, to: funded, actor: { party: renter }
    deadline: { at: self.startsAt }
    moves self.amount from self.renter to self.held
  }
  action return_on_time {
    from: funded, to: returned, actor: { party: programOperator }
    deadline: { at: self.dueAt }
    subject { returnReference: text }
    moves self.held.balance from self.held to self.renter
  }
  action return_late {
    from: funded, to: returned, actor: { party: programOperator }
    due: { at: self.dueAt }
    subject { returnReference: text }
    calculate: [{ target: refund, op: subtract, base: { field: self.held.balance }, subtract: [{ field: self.lateFee }, { field: self.lateTax }] }]
    moves self.lateFee from self.held to programOperator
    moves self.lateTax from self.held to programTax
    moves self.refund from self.held to self.renter
  }
  action refund_before_pickup {
    from: funded, to: cancelled, actor: { party: renter }
    deadline: { at: self.startsAt }
    moves self.held.balance from self.held to self.renter
  }
  action cancel { from: pending, to: cancelled, actor: { party: renter } }
}

object rental "Equipment deposit" {
  fields { equipment: text, serialNumber: text, renterName: text }
  columns: [equipment, serialNumber, renterName, startsAt, dueAt]
  attach security = deposit {
    renter: owner
    rename { startsAt: startsAt, dueAt: dueAt }
    expose create as agree_rental
    expose fund as pay_deposit
    expose return_on_time as return_equipment
    expose return_late as return_equipment_late
    expose refund_before_pickup as cancel_before_pickup
    expose cancel as cancel_unpaid_rental
  }
}
