// Tabuk workshop equipment finance lends 46,000 SAR and reports monthly repayments and arrears.
// Ageing bands at 30, 60 and 90 days distinguish overdue balances from loans written off after 90 days.
program equipment_loan_reports "Tabuk workshop equipment finance"
use reporting
use financing

// Set price to 46,000 SAR, the workshop's 40,000 SAR equipment invoice plus
// 15% VAT charged by its supplier outside this loan. Profit is 6% annually on
// the declining balance. Loan fee: 0%, tax: 0% on principal repayments.
// Reports have no customer fee or tax; they are the lender's internal records.
object purchase "Workshop equipment loan" {
  fields { businessName: text, equipment: text, invoiceReference: text, price: money }
  columns: [businessName, equipment, invoiceReference, price]
  attach allowance = financing.limits {
    borrower: owner, per_borrower: 200000 SAR
    expose create as request_workshop_limit
    expose approve as approve_business
  }
  attach budget = financing.portfolio_limit {
    limit: 5000000 SAR
    expose create as create_lending_budget
    expose approve as approve_budget
  }
  // Create twelve future monthly dates and approve both limits before funding.
  attach loan = financing.installments {
    borrower: owner, capital: operator, share: 0%
    months: 12, pricing: amortizing, profit_rate: 6%, disburse_to: borrower
    payoff_rebate: 100%, refund_within: 30d, write_off_after: 90d
    limits: allowance, portfolio: budget
    expose create as quote_equipment_loan
    expose sign as sign_purchase_loan
    expose disburse as fund_purchase
    expose cancel as decline_loan_quote
    expose void as cancel_unfunded_loan
    expose payoff as repay_early
    expose complete as close_repaid_loan
  }
  // Report requests use reporting routes. This attachment declares their
  // datasets and retention; it neither collects money nor sends a reminder.
  attach reports = reporting.portfolio {
    on: loan, default_days: 90, retention_years: 10
    aging_first_days: 30, aging_second_days: 60, aging_third_days: 90
    expose create as enable_portfolio_reports
  }
}

expose purchase.loan.payment.create as record_repayment
expose purchase.loan.payment.pay as pay_instalment
expose purchase.loan.payment.refund as refund_mistaken_repayment
expose purchase.loan.payoff_quote.create as request_payoff_quote
// Write-off is a capital decision, not an automatic consequence of a report.
expose purchase.loan.write_off_request.create as request_overdue_write_off
expose purchase.loan.write_off_request.apply as approve_overdue_write_off
expose purchase.loan.write_off_request.cancel as cancel_write_off_request
