// A company issues expense cards to employees and reserves each supplier payment before capture.
program team_expense_cards "Team expense cards"
use cards
// supplier is a business this program declares, so plan needs {"partyBindings":{"supplier":"<partyId>"}}.
// That partyId is an organization customer's: create the Product from this source without the payment
// and receipt attachments, add the customer with customer.create, activate its access, open its
// customer_balance account, then compose this source with the binding.
party supplier: business

object employee "Employee card" {
  fields { employeeName: text, department: text }
  columns: [employeeName, department]
  attach holder = cards.cardholder {
    expose create as create_holder
    holder: owner
    expose activate as activate_employee
    expose suspend as suspend_employee
  }
  attach card = cards.card {
    expose create as create_card
    holder: holder, person: owner, spend_limit: 5000 SAR
    expose activate as activate_card
    expose freeze as freeze_card
    expose unfreeze as unfreeze_card
    expose issuer_freeze as block_card
    expose issuer_unfreeze as unblock_card
  }
  attach payment = cards.authorization {
    expose create as create_payment
    card: card, merchant: supplier
    expose approve as approve_payment
    expose capture as capture_payment
    expose reverse as reverse_payment
  }
  attach receipt = cards.transaction {
    expose create as create_receipt
    authorization: payment
    expose refund as refund_payment
  }
}
