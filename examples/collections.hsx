// A business lender refers overdue instalments to an agency with limits on collection contacts.
program business_collections "Small business collections"
use collections
use financing
// agency is a business this program declares, so plan needs {"partyBindings":{"agency":"<partyId>"}}.
// That partyId is an organization customer's: create the Product from this source without the recovery
// and contact attachments, add the customer with customer.create, activate its access, open its
// customer_balance account, then compose this source with the binding.
party agency: business

object facility "Business loan" {
  fields { businessName: text, purpose: text, price: money }
  columns: [businessName, purpose, price]
  attach allowance = financing.limits { expose create as create_allowance, expose approve as approve_borrower, borrower: owner, per_borrower: 100000 SAR }
  attach budget = financing.portfolio_limit { expose create as create_budget, expose approve as approve_budget, limit: 2000000 SAR }
  attach loan = financing.installments {
    expose create as create_loan
    borrower: owner, capital: operator
    months: 12, pricing: amortizing, profit_rate: 6%, disburse_to: borrower
    limits: allowance, portfolio: budget
    expose sign as sign_loan
    expose disburse as release_loan
    expose payoff as repay_early
  }
  attach recovery = collections.case {
    expose create as create_recovery
    on: loan, agency: agency
    expose assign as assign_case
    expose recover as recover_payment
    expose recall as recall_case
  }
  attach contact = collections.contact {
    expose create as create_contact
    case: recovery, agency: agency
  }
}

expose facility.loan.payment.create as create_payment
expose facility.loan.payment.pay as pay_instalment
expose facility.loan.payment.refund as refund_payment
expose facility.loan.payoff_quote.create as request_payoff_quote
