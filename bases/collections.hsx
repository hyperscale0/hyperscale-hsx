// Refer overdue instalments for collection and limit contact attempts.
program collections_base "Follow up overdue payments"
use collections
use financing
party collector: business

object plan "Plan" {
  fields { price: money }
  attach allowance = financing.limits {
    borrower: owner, per_borrower: runtime
    expose create as request_limit
    expose approve as approve_limit
  }
  attach budget = financing.portfolio_limit {
    limit: runtime
    expose create as create_budget
    expose approve as approve_budget
  }
  // Architect sets the placeholder profit rate during tailoring.
  attach plan = financing.installments {
    borrower: owner, capital: operator
    months: 2, pricing: flat_total, profit_rate: 0%
    disburse_to: borrower, limits: allowance, portfolio: budget
    expose create as quote
    expose sign as sign
    expose disburse as fund
    expose cancel as cancel_quote
    expose void as cancel_plan
    expose payoff as repay_early
    expose complete as complete
  }
  attach recovery = collections.case {
    on: plan, agency: collector, capital: operator
    expose create as refer
    expose assign as assign
    expose recover as recover
    expose recall as recall
    expose return_uncollected as return_uncollected
  }
  attach contact = collections.contact {
    case: recovery, agency: collector
    expose create as record_contact
  }
}

expose plan.plan.payment.create as record_payment
expose plan.plan.payment.pay as pay_instalment
expose plan.plan.payment.refund as refund_payment
expose plan.plan.payoff_quote.create as quote_payoff

expose plan.contact.outcome.create as record_contact_outcome
